# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Gallery
GenericName=Photo Library
Comment=Organize photos
Keywords=photos;pictures;images;gallery;library;album;favorites;slideshow;import;camera;screenshots;
Exec=sde-gallery %U
TryExec=sde-gallery
Icon=sde-gallery
Terminal=false
Categories=Graphics;Photography;Viewer;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=SDE-Gallery
MimeType=x-content/image-dcf;x-content/image-picturecd;
Actions=Import;
X-Developer=DebION Dev-Team
X-DebION-Developer=DebION Dev-Team

[Desktop Action Import]
Name=Import from Device
Exec=sde-gallery --import
