# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Photo
GenericName=Photo Viewer and Editor
Comment=Browse pictures and edit them with filters and effects; based on Eye of MATE
Exec=sde-view %U
TryExec=sde-view
Icon=sdeview
Terminal=false
Categories=Graphics;Viewer;Photography;
Keywords=Picture;Photo;Image;Gallery;Filter;Effect;Slideshow;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Sdeview
X-SDE-Upstream=https://github.com/mate-desktop/eom
MimeType=image/png;image/jpeg;image/pjpeg;image/gif;image/webp;image/tiff;image/bmp;image/x-bmp;image/svg+xml;image/svg+xml-compressed;image/avif;image/heic;image/heif;image/jxl;
Actions=Slideshow;

[Desktop Action Slideshow]
Name=Slideshow
Exec=sde-view --slideshow %U
