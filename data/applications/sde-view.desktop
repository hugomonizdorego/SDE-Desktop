# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Photo
GenericName=Image Viewer and Editor
Comment=View and edit images
Exec=sde-view %U
TryExec=sde-view
Icon=sdeview
Terminal=false
Categories=Graphics;RasterGraphics;Viewer;
Keywords=Picture;Photo;Image;Viewer;Editor;Crop;Rotate;Filter;Draw;Annotate;Markup;Blur;Pixelate;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Sdeview
MimeType=image/png;image/jpeg;image/pjpeg;image/gif;image/webp;image/tiff;image/bmp;image/x-bmp;image/svg+xml;image/svg+xml-compressed;image/avif;image/heic;image/heif;image/jxl;
Actions=Draw;
X-Developer=DebION Dev-Team
X-DebION-Developer=DebION Dev-Team

[Desktop Action Draw]
Name=Draw and Annotate
Exec=sde-view --draw %U
