# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Xanara
GenericName=Document Viewer
Comment=Document Viewer for SDE, based on atril
Exec=xanara %U
TryExec=atril
Icon=x-office-document
Terminal=false
Categories=Office;Viewer;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Atril
X-SDE-Upstream=https://github.com/mate-desktop/atril
MimeType=application/pdf;application/postscript;application/epub+zip;
