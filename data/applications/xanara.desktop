# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Xanara
GenericName=PDF Editor
Comment=Read, annotate, edit, fill in, convert and protect PDF documents
Exec=xanara %U
TryExec=xanara
Icon=x-office-document
Terminal=false
Categories=Office;Viewer;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Xanara
MimeType=application/pdf;application/x-pdf;
Keywords=PDF;Annotate;Sign;Form;Redact;OCR;Merge;Viewer;
X-Developer=DebION Dev-Team
X-DebION-Developer=DebION Dev-Team
