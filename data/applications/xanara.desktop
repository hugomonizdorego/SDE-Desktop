[Desktop Entry]
Type=Application
Name=Xanara
GenericName=Document Viewer
Comment=Read, annotate and fill in PDF documents
Exec=xanara %U
TryExec=xanara
Icon=x-office-document
Terminal=false
Categories=Office;Viewer;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Xanara
MimeType=application/pdf;application/x-pdf;
