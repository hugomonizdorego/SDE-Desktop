# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=SDE Power Manager
GenericName=Power Preferences
Comment=Power Preferences for SDE, based on mate-power-manager
Exec=sde-power-manager
TryExec=mate-power-preferences
Icon=preferences-system-power
Terminal=false
Categories=Settings;HardwareSettings;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Mate-power-preferences
X-SDE-Upstream=https://github.com/mate-desktop/mate-power-manager
