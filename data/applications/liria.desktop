# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Liria
GenericName=File Manager
Comment=File Manager for SDE, based on caja
Exec=liria %U
TryExec=caja
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Caja
X-SDE-Upstream=https://github.com/mate-desktop/caja
MimeType=inode/directory;x-scheme-handler/trash;
