# SPDX-License-Identifier: GPL-3.0-or-later
[Desktop Entry]
Type=Application
Name=Liria
GenericName=File Manager
Comment=Browse and organize files, drives and network places
Keywords=files;folders;explorer;drives;network;trash;
Exec=liria %U
TryExec=liria
Icon=liria
Terminal=false
Categories=System;FileTools;FileManager;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=Liria
MimeType=inode/directory;x-scheme-handler/trash;
Actions=new-window;
X-Developer=Selviana DE Project

[Desktop Action new-window]
Name=New Window
Exec=liria --new-window
