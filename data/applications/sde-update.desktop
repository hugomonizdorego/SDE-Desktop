[Desktop Entry]
Type=Application
Name=Software Updater
GenericName=Software Updates
Comment=Install critical, security, main and Flatpak updates
Keywords=update;updates;upgrade;security;critical;flatpak;apt;packages;kernel;SDE Update;Update Manager;
Exec=sde-update
TryExec=sde-update
Icon=system-software-update
Terminal=false
Categories=System;Settings;PackageManager;
OnlyShowIn=SDE;
StartupNotify=true
StartupWMClass=sde-update
X-SDE-Upstream=https://github.com/linuxmint/mintupdate
X-Developer=DebION Dev-Team
X-DebION-Developer=DebION Dev-Team
