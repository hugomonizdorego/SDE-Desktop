Name: Fingerprint authentication for administrator tasks (SDE: sudo and polkit)
Default: no
Priority: 260
Conflicts: fprintd, fprint
Auth-Type: Primary
Auth:
	[success=1 default=ignore]	pam_succeed_if.so quiet service notin sudo:sudo-i:polkit-1
	[success=end default=ignore]	pam_fprintd.so max-tries=1 timeout=10
