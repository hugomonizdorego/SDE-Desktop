Name: Fingerprint authentication for signing in (SDE: login screen and consoles)
Default: no
Priority: 260
Conflicts: fprintd, fprint
Auth-Type: Primary
Auth:
	[success=1 default=ignore]	pam_succeed_if.so quiet service notin login:lightdm:sddm:lxdm:xdm
	[success=end default=ignore]	pam_fprintd.so max-tries=1 timeout=10
