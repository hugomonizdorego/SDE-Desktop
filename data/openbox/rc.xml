<?xml version="1.0" encoding="UTF-8"?>
<!--
  Openbox configuration for the Selviana Desktop Environment (SDE).
  SPDX-License-Identifier: GPL-3.0-or-later

  Copied to ~/.config/sde/openbox/rc.xml on first login. SDE switches the
  window theme (SDE-<Family>-<Mode>-<Accent>) and the button layout with the
  theme chosen in Settings; any other theme or layout you set by
  hand is left alone. The workspaces (<desktops>) and the block of SDE's
  keyboard shortcuts in <keyboard> are written from sde.conf at every login
  (Control Center > Workspaces, docs/SHORTCUTS.md).
-->
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- sde: animateIconify migrated -->
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Mouse</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>
  <theme>
    <name>SDE-Graphite-Light-Blue</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow"><name>Sans</name><size>10</size><weight>Bold</weight><slant>Normal</slant></font>
    <font place="InactiveWindow"><name>Sans</name><size>10</size><weight>Bold</weight><slant>Normal</slant></font>
    <font place="MenuHeader"><name>Sans</name><size>10</size><weight>Bold</weight><slant>Normal</slant></font>
    <font place="MenuItem"><name>Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant></font>
    <font place="ActiveOnScreenDisplay"><name>Sans</name><size>10</size><weight>Bold</weight><slant>Normal</slant></font>
    <font place="InactiveOnScreenDisplay"><name>Sans</name><size>10</size><weight>Bold</weight><slant>Normal</slant></font>
  </theme>
  <desktops>
    <number>2</number>
    <firstdesk>1</firstdesk>
    <names><name>Workspace 1</name><name>Workspace 2</name></names>
    <popupTime>600</popupTime>
  </desktops>
  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Nonpixel</popupShow>
    <popupPosition>Center</popupPosition>
  </resize>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>

  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <!-- SDE shortcuts begin. SDE writes this block from its shortcut list (docs/SHORTCUTS.md);
         change a shortcut in sde.conf [shortcuts]. Keybinds of your own go after the end mark:
         a key bound there wins over SDE's binding for it. -->
    <keybind key="A-F4"><action name="If"><type>desktop</type><then><action name="Execute"><command>sde-logout</command></action></then><else><action name="Close"/></else></action></keybind>
    <keybind key="A-space"><action name="ShowMenu"><menu>client-menu</menu></action></keybind>
    <keybind key="A-Tab"><action name="NextWindow"><allDesktops>no</allDesktops><finalactions><action name="Focus"/><action name="Raise"/><action name="Unshade"/></finalactions></action></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"><allDesktops>no</allDesktops><finalactions><action name="Focus"/><action name="Raise"/><action name="Unshade"/></finalactions></action></keybind>
    <keybind key="A-Escape"><action name="Lower"/><action name="FocusToBottom"/><action name="Unfocus"/></keybind>
    <keybind key="W-Up"><action name="Execute"><command>sde-windows snap up</command></action></keybind>
    <keybind key="W-Down"><action name="Execute"><command>sde-windows snap down</command></action></keybind>
    <keybind key="W-Left"><action name="Execute"><command>sde-windows snap left</command></action></keybind>
    <keybind key="W-Right"><action name="Execute"><command>sde-windows snap right</command></action></keybind>
    <keybind key="W-S-Up"><action name="MaximizeVert"/></keybind>
    <keybind key="W-S-Down"><action name="UnmaximizeVert"/></keybind>
    <keybind key="W-S-Left"><action name="MoveResizeTo"><monitor>prev</monitor></action></keybind>
    <keybind key="W-S-Right"><action name="MoveResizeTo"><monitor>next</monitor></action></keybind>
    <keybind key="W-h"><action name="Iconify"/></keybind>
    <keybind key="W-m"><action name="Execute"><command>sde-windows minimize-all</command></action></keybind>
    <keybind key="W-S-m"><action name="Execute"><command>sde-windows restore-minimized</command></action></keybind>
    <keybind key="W-Home"><action name="Execute"><command>sde-windows minimize-others</command></action></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="W-Tab"><action name="Execute"><command>sde-taskview</command></action></keybind>
    <keybind key="C-A-Tab"><action name="Execute"><command>sde-taskview</command></action></keybind>
    <keybind key="C-W-d"><action name="Execute"><command>sde-windows workspace new</command></action></keybind>
    <keybind key="C-W-F4"><action name="Execute"><command>sde-windows workspace close</command></action></keybind>
    <keybind key="C-W-Left"><action name="GoToDesktop"><to>left</to><wrap>no</wrap></action></keybind>
    <keybind key="C-A-Left"><action name="GoToDesktop"><to>left</to><wrap>no</wrap></action></keybind>
    <keybind key="C-W-Right"><action name="GoToDesktop"><to>right</to><wrap>no</wrap></action></keybind>
    <keybind key="C-A-Right"><action name="GoToDesktop"><to>right</to><wrap>no</wrap></action></keybind>
    <keybind key="C-W-S-Left"><action name="SendToDesktop"><to>left</to><wrap>no</wrap><follow>yes</follow></action></keybind>
    <keybind key="C-A-S-Left"><action name="SendToDesktop"><to>left</to><wrap>no</wrap><follow>yes</follow></action></keybind>
    <keybind key="C-W-S-Right"><action name="SendToDesktop"><to>right</to><wrap>no</wrap><follow>yes</follow></action></keybind>
    <keybind key="C-A-S-Right"><action name="SendToDesktop"><to>right</to><wrap>no</wrap><follow>yes</follow></action></keybind>
    <keybind key="Super_L" onRelease="yes"><action name="Execute"><command>sde-panel --menu</command></action></keybind>
    <keybind key="Super_R" onRelease="yes"><action name="Execute"><command>sde-panel --menu</command></action></keybind>
    <keybind key="C-Escape"><action name="Execute"><command>sde-panel --menu</command></action></keybind>
    <keybind key="A-F1"><action name="Execute"><command>sde-panel --menu</command></action></keybind>
    <keybind key="W-s"><action name="Execute"><command>sde-panel --search</command></action></keybind>
    <keybind key="W-q"><action name="Execute"><command>sde-panel --search</command></action></keybind>
    <keybind key="W-r"><action name="Execute"><command>sde-run</command></action></keybind>
    <keybind key="A-F2"><action name="Execute"><command>sde-run</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>sh -c 'command -v liria &gt;/dev/null &amp;&amp; exec liria --no-desktop "$HOME" || exec xdg-open "$HOME"'</command></action></keybind>
    <keybind key="W-i"><action name="Execute"><command>sde-settings</command></action></keybind>
    <keybind key="W-a"><action name="Execute"><command>sde-panel --action-center</command></action></keybind>
    <keybind key="W-n"><action name="Execute"><command>sde-panel --notifications</command></action></keybind>
    <keybind key="W-c"><action name="Execute"><command>sde-panel --calendar</command></action></keybind>
    <keybind key="W-A-d"><action name="Execute"><command>sde-panel --calendar</command></action></keybind>
    <keybind key="W-w"><action name="Execute"><command>sde-panel --calendar</command></action></keybind>
    <keybind key="W-x"><action name="Execute"><command>sde-panel --quick-link-menu</command></action></keybind>
    <keybind key="C-A-t"><action name="Execute"><command>sde-run --terminal</command></action></keybind>
    <keybind key="C-S-Escape"><action name="Execute"><command>sde-system-monitor</command></action></keybind>
    <keybind key="W-1"><action name="Execute"><command>sde-panel --taskbar 1</command></action></keybind>
    <keybind key="W-2"><action name="Execute"><command>sde-panel --taskbar 2</command></action></keybind>
    <keybind key="W-3"><action name="Execute"><command>sde-panel --taskbar 3</command></action></keybind>
    <keybind key="W-4"><action name="Execute"><command>sde-panel --taskbar 4</command></action></keybind>
    <keybind key="W-5"><action name="Execute"><command>sde-panel --taskbar 5</command></action></keybind>
    <keybind key="W-6"><action name="Execute"><command>sde-panel --taskbar 6</command></action></keybind>
    <keybind key="W-7"><action name="Execute"><command>sde-panel --taskbar 7</command></action></keybind>
    <keybind key="W-8"><action name="Execute"><command>sde-panel --taskbar 8</command></action></keybind>
    <keybind key="W-9"><action name="Execute"><command>sde-panel --taskbar 9</command></action></keybind>
    <keybind key="W-S-1"><action name="Execute"><command>sde-panel --taskbar-new 1</command></action></keybind>
    <keybind key="W-S-2"><action name="Execute"><command>sde-panel --taskbar-new 2</command></action></keybind>
    <keybind key="W-S-3"><action name="Execute"><command>sde-panel --taskbar-new 3</command></action></keybind>
    <keybind key="W-S-4"><action name="Execute"><command>sde-panel --taskbar-new 4</command></action></keybind>
    <keybind key="W-S-5"><action name="Execute"><command>sde-panel --taskbar-new 5</command></action></keybind>
    <keybind key="W-S-6"><action name="Execute"><command>sde-panel --taskbar-new 6</command></action></keybind>
    <keybind key="W-S-7"><action name="Execute"><command>sde-panel --taskbar-new 7</command></action></keybind>
    <keybind key="W-S-8"><action name="Execute"><command>sde-panel --taskbar-new 8</command></action></keybind>
    <keybind key="W-S-9"><action name="Execute"><command>sde-panel --taskbar-new 9</command></action></keybind>
    <keybind key="W-t"><action name="Execute"><command>sde-panel --focus-taskbar</command></action></keybind>
    <keybind key="W-b"><action name="Execute"><command>sde-panel --section tray</command></action></keybind>
    <keybind key="Print"><action name="Execute"><command>sde-screenshot --screen</command></action></keybind>
    <keybind key="W-Print"><action name="Execute"><command>sde-screenshot --screen</command></action></keybind>
    <keybind key="A-Print"><action name="Execute"><command>sde-screenshot --window</command></action></keybind>
    <keybind key="W-S-s"><action name="Execute"><command>sde-screenshot --snip</command></action></keybind>
    <keybind key="W-period"><action name="Execute"><command>sde-windows emoji</command></action></keybind>
    <keybind key="W-semicolon"><action name="Execute"><command>sde-windows emoji</command></action></keybind>
    <keybind key="C-A-Delete"><action name="Execute"><command>sde-logout --security</command></action></keybind>
    <keybind key="W-l"><action name="Execute"><command>sde-lock</command></action></keybind>
    <keybind key="C-A-l"><action name="Execute"><command>sde-lock</command></action></keybind>
    <keybind key="W-p"><action name="Execute"><command>sde-settings --page display</command></action></keybind>
    <keybind key="W-Pause"><action name="Execute"><command>sde-settings --page about</command></action></keybind>
    <keybind key="W-k"><action name="Execute"><command>sde-panel --section bluetooth</command></action></keybind>
    <keybind key="W-space"><action name="Execute"><command>sde-windows next-layout</command></action></keybind>
    <keybind key="A-S-F12"><action name="Execute"><command>sde-session --compositor toggle</command></action></keybind>
    <keybind key="C-W-S-b"><action name="Execute"><command>sde-session --compositor restart</command></action></keybind>
    <!-- SDE shortcuts end -->
  </keyboard>

  <mouse>
    <dragThreshold>3</dragThreshold>
    <doubleClickTime>400</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>
    <context name="Frame">
      <mousebind button="A-Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
      <mousebind button="Up" action="Click"><action name="if"><shaded>no</shaded><then><action name="Shade"/></then></action></mousebind>
      <mousebind button="Down" action="Click"><action name="if"><shaded>yes</shaded><then><action name="Unshade"/></then></action></mousebind>
    </context>
    <context name="Titlebar Top Right Bottom Left TLCorner TRCorner BRCorner BLCorner">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Lower"/><action name="FocusToBottom"/><action name="Unfocus"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="Top"><mousebind button="Left" action="Drag"><action name="Resize"><edge>top</edge></action></mousebind></context>
    <context name="Left"><mousebind button="Left" action="Drag"><action name="Resize"><edge>left</edge></action></mousebind></context>
    <context name="Right"><mousebind button="Left" action="Drag"><action name="Resize"><edge>right</edge></action></mousebind></context>
    <context name="Bottom"><mousebind button="Left" action="Drag"><action name="Resize"><edge>bottom</edge></action></mousebind></context>
    <context name="TRCorner BRCorner TLCorner BLCorner">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    </context>
    <context name="Icon">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="AllDesktops"><mousebind button="Left" action="Click"><action name="ToggleOmnipresent"/></mousebind></context>
    <context name="Shade"><mousebind button="Left" action="Click"><action name="ToggleShade"/></mousebind></context>
    <context name="Iconify"><mousebind button="Left" action="Click"><action name="Iconify"/></mousebind></context>
    <context name="Maximize">
      <mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind>
      <mousebind button="Middle" action="Click"><action name="ToggleMaximize"><direction>vertical</direction></action></mousebind>
      <mousebind button="Right" action="Click"><action name="ToggleMaximize"><direction>horizontal</direction></action></mousebind>
    </context>
    <context name="Close"><mousebind button="Left" action="Click"><action name="Close"/></mousebind></context>
    <!-- The desktop window is drawn by sde-desktop, which handles its own
         clicks; focusing it lets its keyboard shortcuts (F5, F2, Delete) work. -->
    <context name="Desktop">
      <mousebind button="Left" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/></mousebind>
    </context>
  </mouse>

  <menu>
    <hideDelay>200</hideDelay>
    <middle>no</middle>
    <submenuShowDelay>100</submenuShowDelay>
    <submenuHideDelay>400</submenuHideDelay>
    <showIcons>yes</showIcons>
    <manageDesktops>yes</manageDesktops>
  </menu>

  <applications>
    <application class="SDE-Panel"><decor>no</decor><layer>above</layer><skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager></application>
    <application class="SDE-Desktop"><decor>no</decor><focus>no</focus><layer>below</layer><skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager></application>
  </applications>
</openbox_config>
