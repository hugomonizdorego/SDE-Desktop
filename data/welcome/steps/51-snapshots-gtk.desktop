[Desktop Entry]
Type=Application
Name=Snapshots
Comment=Restore the system if an update breaks it
Icon=timeshift
X-SDE-Fallback-Icons=document-revert;backup;drive-harddisk
Exec=timeshift-gtk
NoDisplay=true
X-SDE-Welcome-Fallback=52-system-reports.desktop
X-SDE-Gettext-Domain=sde
