<schemalist>
  <schema id="org.debion.session" path="/org/debion/session/">
    <key name="idle-delay" type="i">
      <default>5</default>
      <range min="0" max="2147483647"/>
      <summary>Session idle delay</summary>
      <description>Minutes without input before SDE Screen Lock considers the session idle. Zero disables the idle timeout.</description>
    </key>
  </schema>
</schemalist>
