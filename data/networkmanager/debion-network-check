#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# debion-network-check - find out why a DebION desktop says "connected" but
# a browser cannot reach the internet, and optionally fix the usual causes.
#
#   debion-network-check              full report (any user; no changes)
#   debion-network-check --quick --json
#                                     a few fast checks as one JSON object
#                                     (for the panel and Settings)
#   sudo debion-network-check --fix   repair what is safe to repair:
#                                     hand DHCP/Wi-Fi interfaces from
#                                     /etc/network/interfaces to NetworkManager,
#                                     stop a second DHCP client, give
#                                     /etc/resolv.conf back to one owner and
#                                     turn on network time; then wait
#                                     and check that DNS really works
#   sudo debion-network-check --dns-fallback [off]
#                                     use public DNS servers (1.1.1.1,
#                                     9.9.9.9) on the active connection when
#                                     the network gives none (off: undo)
#   debion-network-check --wpad       print the proxy auto-configuration URL
#                                     this network publishes (WPAD), if any
#   sudo debion-network-check --apt-proxy URL|none
#                                     set (or remove) the proxy used by APT
#   sudo debion-network-check --boot-repair
#                                     the quick, unattended repair run at
#                                     every boot (debion-network-repair.service):
#                                     only safe, idempotent changes, then
#                                     check that DNS works
#   debion-network-check --postinst   used by the package scripts
#
# Opt out of every automatic repair (boot, package upgrades, the panel):
# [network] auto_repair=false in /etc/debion/network.conf.
#
# It never touches static, bridge, bond, VLAN or wpa-conf/wpa-roam
# configurations: those are deliberate server-style setups.
set -u

VERSION=2
MODE=report
NOW=0
APT_PROXY_ARG=""
FALLBACK_OFF=0
FIRST_INSTALL=0
# pkexec clears the environment already; never let path overrides (meant for
# the tests) reach a run that polkit authorized.
if [ -n "${PKEXEC_UID:-}" ]; then
    for v in $(env | sed -n 's/^\(DEBION_[A-Z0-9_]*\)=.*/\1/p'); do unset "$v"; done
fi
while [ $# -gt 0 ]; do
    case "$1" in
        --fix) MODE=fix ;;
        --now) NOW=1 ;;
        --postinst) MODE=postinst ;;
        --handover) MODE=handover ;;
        --quick) MODE=quick ;;
        --json) [ "$MODE" = report ] && MODE=quick ;;
        --wpad) MODE=wpad ;;
        --apt-proxy) MODE=apt-proxy; APT_PROXY_ARG=${2:-}; [ $# -gt 1 ] && shift ;;
        --dns-fallback) MODE=dns-fallback
            if [ "${2:-}" = off ]; then FALLBACK_OFF=1; shift; fi ;;
        --postinst-dns) MODE=postinst-dns ;;
        --postinst-repair) MODE=postinst-repair ;;
        --first-install) FIRST_INSTALL=1 ;;
        --boot-repair)
            # Also the mode the passwordless polkit action runs (through
            # /usr/libexec/debion-network-repair): nothing may follow it.
            if [ $# -gt 1 ]; then echo "debion-network-check: --boot-repair takes no other option" >&2; exit 2; fi
            MODE=boot-repair ;;
        # Building blocks, used by the tests.
        --list-convertible|--convert-interfaces|--dhcp-clients|--wpad-candidates|--explain-curl|--resolv-owner|--wifi-profiles)
            MODE=${1#--} ;;
        -h|--help)
            sed -n '3,36p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *) [ "${MODE}" = explain-curl ] || [ "$MODE" = wifi-profiles ] && break
           echo "usage: debion-network-check [--quick --json | --fix [--now] | --dns-fallback [off] | --wpad | --apt-proxy URL|none]" >&2; exit 2 ;;
    esac
    shift
done

# polkit (org.debion.network-check.fix) authorizes this program, whatever
# its arguments: through pkexec only what the desktop offers may run. The
# package-script modes and the test building blocks (--wifi-profiles DIR
# writes files as root into any directory) are for root and the tests.
if [ -n "${PKEXEC_UID:-}" ]; then
    case "$MODE" in
        report|quick|wpad|fix|dns-fallback|apt-proxy|boot-repair) ;;
        *) echo "debion-network-check: --$MODE is not available through pkexec" >&2; exit 2 ;;
    esac
fi

IFACES=${DEBION_NETWORK_INTERFACES:-/etc/network/interfaces}
RESOLV=${DEBION_RESOLV_CONF:-/etc/resolv.conf}
SYSNET=${DEBION_SYS_CLASS_NET:-/sys/class/net}
NMCONN=${DEBION_NM_CONNECTIONS:-/etc/NetworkManager/system-connections}
BACKUPS=${DEBION_BACKUP_DIR:-/var/backups/debion-network}
NM_RUN_CONF=${DEBION_NM_RUN_CONF:-/run/NetworkManager/conf.d}
NM_CONF_DIR=${DEBION_NM_CONF_DIR:-/etc/NetworkManager/conf.d}
NM_BIN=${DEBION_NM_BINARY:-/usr/sbin/NetworkManager}
SYSTEMD_RUN=${DEBION_SYSTEMD_RUN:-/run/systemd/system}
NM_MAIN_CONF=${DEBION_NM_MAIN_CONF:-/etc/NetworkManager/NetworkManager.conf}
NET_CONF=${DEBION_NETWORK_CONF:-/etc/debion/network.conf}
LOGFILE=${DEBION_NETWORK_LOG:-/var/log/debion-network-check.log}
# How long --fix waits for NetworkManager to write working DNS servers.
DNS_WAIT=${DEBION_DNS_WAIT:-10}
FALLBACK_DNS="1.1.1.1 9.9.9.9"
TEST_HOST=deb.debian.org
TIMEOUT=${DEBION_NET_TIMEOUT:-5}

problems=0
say() { case "$MODE" in postinst|handover|quick|boot-repair|postinst-repair) ;; *) printf '%s\n' "$*" ;; esac; }
ok() { say "  OK    $*"; }
warn() { problems=$((problems + 1)); say "  WARN  $*"; }
info() { say "  INFO  $*"; }
more() { say "        $*"; }

have() { command -v "$1" >/dev/null 2>&1; }

nm_running() {
    if have systemctl && [ -d "$SYSTEMD_RUN" ]; then
        systemctl is-active --quiet NetworkManager.service
    else
        pidof NetworkManager >/dev/null 2>&1
    fi
}

unit_active() { have systemctl && [ -d "$SYSTEMD_RUN" ] && systemctl is-active --quiet "$1" 2>/dev/null; }
have_timesyncd() {
    for t in ${DEBION_TIMESYNCD:-/lib/systemd/systemd-timesyncd /usr/lib/systemd/systemd-timesyncd}; do
        [ -x "$t" ] && return 0
    done
    return 1
}

stamp() { date +%Y%m%d-%H%M%S; }

# ------------------------------------------------------- /etc/network/interfaces

interfaces_files() {
    printf '%s\n' "$IFACES"
    if [ -d "$IFACES.d" ]; then
        for f in "$IFACES.d"/*; do
            # ifupdown's "source-directory" skips names with dots; the
            # Debian default "source /etc/network/interfaces.d/*" does not.
            [ -f "$f" ] && printf '%s\n' "$f"
        done
    fi
}

# Physical interfaces that ifupdown configures only with DHCP, SLAAC or a
# wpa-ssid/wpa-psk network (one name per line). An interface with any static,
# bridge, bond, VLAN, hook or wpa-conf/wpa-roam line, or one that another
# stanza uses as a bridge port, bond slave or VLAN device, is left alone.
ifupdown_dhcp_ifaces() {
    interfaces_files | while IFS= read -r f; do cat "$f" 2>/dev/null; echo; done | awk '
        function flush() {
            if (cur == "") return
            good = (method == "dhcp" || method == "auto" || (method == "manual" && wpa)) && !special
            print cur, good
            cur = ""
        }
        { sub(/^[ \t]+/, "") }
        $1 ~ /^#/ { next }
        $1 == "iface" {
            flush()
            if ($2 != "lo" && $2 !~ /[.:@]/) { cur = $2; method = $4; special = 0; wpa = 0 }
            else if ($2 != "lo") { print $2, 0 }
            next
        }
        $1 == "mapping" { flush(); mapped = 1; next }
        $1 ~ /^(auto|allow-|source|rename|no-auto-down|no-scripts)/ { flush(); next }
        # Lines that tie other interfaces to this stanza.
        $1 ~ /^(bridge[-_]ports|bond[-_]slaves|bond[-_]master|vlan[-_]raw[-_]device|ovs_bridge|ovs_ports)$/ {
            for (i = 2; i <= NF; i++) used[$i] = 1
        }
        cur == "" { next }
        $1 == "wpa-ssid" || $1 == "wpa-psk" || $1 == "wpa-key-mgmt" || $1 == "wpa-bssid" || $1 == "wpa-scan-ssid" { wpa = 1; next }
        $1 ~ /^wpa-/ { special = 1; next }
        $1 ~ /^(address|netmask|gateway|broadcast|network|pointopoint|scope|bridge|bond|vlan|ovs|pre-up|up|post-up|down|pre-down|post-down|hwaddress|dns-|mtu|wireless-|provider|tunnel|endpoint|local|ttl|mode|media|accept_ra|autoconf|privext|dhcp|request_prefix|ll-)/ { special = 1 }
        END {
            flush()
            for (n in used) print n, 0
            if (mapped) print "*mapping*", 0
        }
    ' | awk '
        { seen[$1] = 1; if ($2 == 0) bad[$1] = 1 }
        END { if (bad["*mapping*"]) exit; for (n in seen) if (!bad[n]) print n }
    ' | sort | while IFS= read -r n; do
        # Only interfaces this machine has (when that can be checked).
        if [ -d "$SYSNET" ] && [ ! -e "$SYSNET/$n" ]; then continue; fi
        printf '%s\n' "$n"
    done
}

# Prints |file| with the stanzas (and auto/allow-* entries) of the
# interfaces in |list| commented out.
convert_file() {
    awk -v list=" $2 " '
        function managed(n) { return index(list, " " n " ") > 0 }
        {
            line = $0; t = $0; sub(/^[ \t]+/, "", t)
            split(t, f, /[ \t]+/)
        }
        f[1] ~ /^(auto|allow-hotplug|allow-auto|allow-[a-z]+)$/ {
            skip = 0
            out = f[1]; kept = 0; dropped = 0
            n = split(t, w, /[ \t]+/)
            for (i = 2; i <= n; i++) {
                if (w[i] == "") continue
                if (managed(w[i])) dropped = 1; else { out = out " " w[i]; kept = 1 }
            }
            if (!dropped) { print line; next }
            print "# " line "  # moved to NetworkManager by debion-network-check"
            if (kept) print out
            next
        }
        f[1] == "iface" { skip = managed(f[2]) }
        f[1] ~ /^(mapping|source|source-directory|rename)$/ { skip = 0 }
        skip { print "# " line; next }
        { print line }
    ' "$1"
}

# Writes a NetworkManager keyfile for every wpa-ssid stanza of an interface
# in |list| into |dir| (mode 600). Prints the files it wrote.
wifi_profiles() {
    list=" $1 "; dir=$2
    interfaces_files | while IFS= read -r f; do cat "$f" 2>/dev/null; echo; done | awk -v list="$list" '
        function flush() {
            if (cur != "" && ssid != "") printf "%s\037%s\037%s\037%s\n", cur, ssid, psk, mgmt
            cur = ""; ssid = ""; psk = ""; mgmt = ""
        }
        function unq(s) { if (s ~ /^".*"$/) s = substr(s, 2, length(s) - 2); return s }
        { sub(/^[ \t]+/, "") }
        $1 == "iface" { flush(); if (index(list, " " $2 " ") > 0) cur = $2; next }
        $1 ~ /^(auto|allow-|mapping|source)/ { flush(); next }
        cur != "" && $1 == "wpa-ssid" { v = $0; sub(/^wpa-ssid[ \t]+/, "", v); ssid = unq(v) }
        cur != "" && $1 == "wpa-psk" { v = $0; sub(/^wpa-psk[ \t]+/, "", v); psk = unq(v) }
        cur != "" && $1 == "wpa-key-mgmt" { mgmt = $2 }
        END { flush() }
    ' | while IFS="$(printf '\037')" read -r dev ssid psk mgmt; do
        uuid=${DEBION_UUID:-$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo 00000000-0000-4000-8000-000000000000)}
        name=$(printf '%s' "$ssid" | tr -c 'A-Za-z0-9._-' '_')
        out="$dir/ifupdown-$dev-$name.nmconnection"
        [ -e "$out" ] && continue
        esc() { printf '%s' "$1" | sed 's/\\/\\\\/g'; }
        (
            umask 077
            {
                echo "# Imported from /etc/network/interfaces by debion-network-check"
                echo "[connection]"
                echo "id=$(esc "$ssid")"
                echo "uuid=$uuid"
                echo "type=wifi"
                echo "interface-name=$dev"
                echo "autoconnect=true"
                echo ""
                echo "[wifi]"
                echo "mode=infrastructure"
                echo "ssid=$(esc "$ssid")"
                echo ""
                if [ -n "$psk" ] && [ "$mgmt" != NONE ]; then
                    echo "[wifi-security]"
                    echo "key-mgmt=wpa-psk"
                    echo "psk=$(esc "$psk")"
                    echo ""
                fi
                echo "[ipv4]"
                echo "method=auto"
                echo ""
                echo "[ipv6]"
                echo "method=auto"
            } > "$out"
        )
        chmod 600 "$out" 2>/dev/null
        printf '%s\n' "$out"
    done
}

# Hands |list| from ifupdown to NetworkManager: backs up and edits every
# file that configures them, imports Wi-Fi networks. With |now|=1 the
# interfaces are taken down by ifupdown first (while the old configuration
# is still there) and NetworkManager is restarted afterwards.
handover() {
    list=$1; now=$2; dest=$3
    mkdir -p "$dest"
    if [ "$now" = 1 ] && have ifdown; then
        for n in $list; do ifdown --force "$n" >/dev/null 2>&1 || true; done
    fi
    [ -d "$NMCONN" ] || mkdir -p "$NMCONN"
    wifi_profiles "$list" "$NMCONN" | sed 's/^/  imported Wi-Fi network: /'
    interfaces_files | while IFS= read -r f; do
        [ -f "$f" ] || continue
        convert_file "$f" "$list" > "$f.debion-new" || { rm -f "$f.debion-new"; continue; }
        if cmp -s "$f" "$f.debion-new"; then rm -f "$f.debion-new"; continue; fi
        # Backups never go next to the file: ifupdown sources every file
        # in interfaces.d, and a copy there would configure the NIC again.
        cp -p "$f" "$dest/$(printf '%s' "$f" | tr / _)"
        chmod --reference="$f" "$f.debion-new" 2>/dev/null || true
        mv "$f.debion-new" "$f"
    done
    echo "Moved to NetworkManager: $list"
    echo "Backup: $dest"
    if [ "$now" = 1 ]; then
        rm -f "$NM_RUN_CONF/90-debion-handover.conf"
        if have systemctl && [ -d "$SYSTEMD_RUN" ]; then
            systemctl restart NetworkManager.service 2>/dev/null || true
        fi
    fi
}

# Interfaces whose handover waits for the next boot (see --handover), and
# the backup that still describes them for ifdown.
pending_handover() { sed -n 's/^unmanaged-devices+=//p' "$NM_RUN_CONF/90-debion-handover.conf" 2>/dev/null | tr ';' '\n' | sed -n 's/^interface-name://p' | tr '\n' ' ' | sed 's/ $//'; }
pending_backup() { sed -n 's/^# backup: //p' "$NM_RUN_CONF/90-debion-handover.conf" 2>/dev/null; }

# ---------------------------------------------------------- DHCP clients

# Lists DHCP clients that are not NetworkManager's own (which runs inside
# NetworkManager or as "dhclient ... /run/NetworkManager/..."):
# "PID CLIENT IFACE", IFACE "*" for a dhcpcd manager serving all interfaces.
# Reads "ps -eo pid=,args=" (or $DEBION_PS_OUTPUT).
dhcp_clients() {
    known=""
    if [ -d "$SYSNET" ]; then
        for d in "$SYSNET"/*; do [ -e "$d" ] && known="$known ${d##*/}"; done
    fi
    known="$known ${DEBION_KNOWN_IFACES:-}"
    if [ -n "${DEBION_PS_OUTPUT:-}" ]; then cat "$DEBION_PS_OUTPUT"; else ps -eo pid=,args= 2>/dev/null; fi | awk -v known=" $known " '
        {
            pid = $1; cmd = $2; sub(/.*\//, "", cmd)
            if ($0 ~ /NetworkManager/) next
            if (cmd == "dhclient") client = "dhclient"
            else if (cmd == "dhcpcd" || cmd == "dhcpcd:") client = "dhcpcd"
            else if (cmd == "udhcpc" || cmd == "dhcpcd-run-hooks") { if (cmd == "udhcpc") client = "udhcpc"; else next }
            else next
            # dhcpcd helpers serve the manager; they are not separate clients.
            if ($0 ~ /\[(privileged|network|control) proxy\]|\[privileged actioneer\]|\[launcher\]/) next
            ifs = ""
            for (i = 3; i <= NF; i++) {
                w = $i
                if (w ~ /^-/) { if (client == "dhcpcd" && w ~ /^-(c|e|f|h|i|I|l|m|o|O|r|s|S|t|u|v|y|z)$/) i++; continue }
                if (index(known, " " w " ") > 0 && w != "lo") ifs = ifs " " w
            }
            if (client == "dhclient") {
                # dhclient: the interfaces are the trailing arguments.
                ifs = ""
                for (i = NF; i >= 3; i--) { if ($i ~ /^-/ || $(i-1) ~ /^-(pf|lf|cf|sf|df|e|s|p)$/) break; ifs = " " $i ifs }
            }
            if (ifs == "") ifs = " *"
            n = split(substr(ifs, 2), a, " ")
            for (j = 1; j <= n; j++) if (!seen[client " " a[j]]++) print pid, client, a[j]
        }
    '
}

# ----------------------------------------------------------------- DNS

# Who writes /etc/resolv.conf: networkmanager, systemd-resolved,
# resolvconf, dhclient, static, dangling, missing, empty.
resolv_owner() {
    if [ -L "$RESOLV" ]; then
        target=$(readlink "$RESOLV")
        [ -e "$RESOLV" ] || { echo dangling; return; }
        case "$target" in
            *systemd/resolve*) echo systemd-resolved ;;
            *NetworkManager*) echo networkmanager ;;
            *resolvconf*) echo resolvconf ;;
            *) echo static ;;
        esac
        return
    fi
    [ -e "$RESOLV" ] || { echo missing; return; }
    grep -q '^[ \t]*nameserver' "$RESOLV" 2>/dev/null || { echo empty; return; }
    if grep -qi 'generated by networkmanager' "$RESOLV"; then echo networkmanager
    elif grep -qi 'resolvconf' "$RESOLV"; then echo resolvconf
    elif grep -qi 'systemd-resolved' "$RESOLV"; then echo systemd-resolved
    elif grep -qi 'dhclient\|dhcpcd' "$RESOLV"; then echo dhclient
    else echo static
    fi
}

# ------------------------------------------------- DNS: who blocks it
#
# NetworkManager knows the DNS servers of a connection (its connectivity
# check asks them directly), but programs only use /etc/resolv.conf. It
# stays without a name server when NetworkManager is told not to write it
# (dns=none, rc-manager=unmanaged), hands it to resolvconf/netconfig or a
# systemd-resolved that is not running, finds a symlink it must not replace
# (rc-manager=symlink/auto), cannot write it (chattr +i), has no servers for
# it (ipv4.ignore-auto-dns, a DHCP lease without DNS) or does not manage the
# device at all (unmanaged, "connected (externally)" by ifupdown).

has_ns() { [ -r "$RESOLV" ] && grep -q '^[ \t]*nameserver' "$RESOLV" 2>/dev/null; }
dns_works() { has_ns && getent ahosts "$TEST_HOST" >/dev/null 2>&1; }
resolv_servers() { awk '$1 == "nameserver" {print $2}' "$RESOLV" 2>/dev/null | tr '\n' ' ' | sed 's/ $//'; }
resolved_to() { getent ahosts "$TEST_HOST" 2>/dev/null | awk '{print $1}' | sort -u | head -n3 | tr '\n' ' ' | sed 's/ $//'; }

# A [main] key of NetworkManager's merged configuration
# (NetworkManager --print-config), or |default| when it is not set.
nm_main_value() {
    v=""
    if [ -x "$NM_BIN" ]; then
        v=$("$NM_BIN" --print-config 2>/dev/null | awk -v k="$1" '
            /^[ \t]*\[/ { s = $0; gsub(/[][ \t]/, "", s); next }
            s == "main" {
                line = $0; sub(/^[ \t]+/, "", line)
                if (line ~ /^#/) next
                if (index(line, k "=") == 1) { v = substr(line, length(k) + 2); gsub(/[ \t]/, "", v) }
            }
            END { print v }')
    fi
    echo "${v:-$2}"
}

nm_list() { tr '|,' '\n\n' | tr -d ' \t' | grep . | awk '!seen[$0]++' | tr '\n' ' ' | sed 's/ $//'; }

# Fills D_*: the device with the default route (or the first Ethernet/Wi-Fi
# device), its state and connection, the DNS servers NetworkManager has for
# it, what the DHCP lease said, the connection's ipv4.ignore-auto-dns and
# ipv4.dns, NetworkManager's dns= and rc-manager=, and the state of
# systemd-resolved, resolvconf and the immutable flag.
dns_state() {
    D_DEV=""; D_STATE=""; D_CON=""; D_CON_NAME=""; D_NMDNS=""; D_DHCPDNS=unknown
    D_IGNORE=""; D_CONDNS=""
    D_MODE=$(nm_main_value dns default)
    D_RC=$(nm_main_value rc-manager auto)
    D_RESOLVED=no; unit_active systemd-resolved.service && D_RESOLVED=yes
    D_RESOLVCONF=""
    for p in ${DEBION_RESOLVCONF-/usr/sbin/resolvconf /sbin/resolvconf /usr/bin/resolvconf}; do
        [ -x "$p" ] && { D_RESOLVCONF=$p; break; }
    done
    D_IMMUTABLE=no
    if [ -f "$RESOLV" ] && have lsattr; then
        case "$(lsattr -d "$RESOLV" 2>/dev/null | awk '{print $1}')" in *i*) D_IMMUTABLE=yes ;; esac
    fi
    have nmcli && nm_running || return 0
    have ip && D_DEV=$(ip -4 route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
    if [ -z "$D_DEV" ]; then
        D_DEV=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "ethernet" || $2 == "wifi" { print $1; exit }')
    fi
    [ -n "$D_DEV" ] || return 0
    D_STATE=$(nmcli -g GENERAL.STATE device show "$D_DEV" 2>/dev/null | head -n1)
    D_CON_NAME=$(nmcli -g GENERAL.CONNECTION device show "$D_DEV" 2>/dev/null | head -n1)
    D_CON=$(nmcli -g GENERAL.CON-UUID device show "$D_DEV" 2>/dev/null | head -n1)
    [ -n "$D_CON" ] || D_CON=$D_CON_NAME
    D_NMDNS=$( { nmcli -g IP4.DNS device show "$D_DEV" 2>/dev/null; nmcli -g IP6.DNS device show "$D_DEV" 2>/dev/null; } | nm_list)
    dhcp=$(nmcli -t -f DHCP4 device show "$D_DEV" 2>/dev/null)
    if [ -n "$dhcp" ]; then
        D_DHCPDNS=$(printf '%s\n' "$dhcp" | sed -n 's/^DHCP4\.OPTION\[[0-9]*\]:domain_name_servers *= *//p' | head -n1)
        [ -n "$D_DHCPDNS" ] || D_DHCPDNS=none
    fi
    if [ -n "$D_CON" ]; then
        D_IGNORE=$(nmcli -g ipv4.ignore-auto-dns connection show "$D_CON" 2>/dev/null | head -n1)
        D_CONDNS=$(nmcli -g ipv4.dns connection show "$D_CON" 2>/dev/null | nm_list)
    fi
}

# Prints why NetworkManager does not (or cannot) put name servers into
# /etc/resolv.conf, one finding per line (for the report).
dns_findings() {
    dns_state
    owner=$(resolv_owner)
    info "NetworkManager configuration: dns=$D_MODE, rc-manager=$D_RC (NetworkManager --print-config)"
    if [ -n "$D_DEV" ]; then
        info "$D_DEV (${D_CON_NAME:-no connection}, ${D_STATE:-unknown state}): NetworkManager's DNS servers: ${D_NMDNS:-none}"
    fi
    [ "$D_IMMUTABLE" = yes ] && warn "$RESOLV is immutable (chattr +i): nothing can write name servers into it"
    case "$D_MODE" in
        none) warn "NetworkManager is configured with dns=none: it never writes $RESOLV" ;;
        systemd-resolved) [ "$D_RESOLVED" = yes ] || warn "NetworkManager is configured with dns=systemd-resolved, but systemd-resolved is not running" ;;
    esac
    case "$D_RC" in
        unmanaged) warn "NetworkManager is configured with rc-manager=unmanaged: it never writes $RESOLV" ;;
        resolvconf|netconfig) warn "NetworkManager hands DNS to $D_RC (rc-manager=$D_RC) instead of writing $RESOLV" ;;
        symlink) [ -L "$RESOLV" ] && warn "rc-manager=symlink and $RESOLV is a symlink: NetworkManager leaves it alone" ;;
        auto)
            if [ -n "$D_RESOLVCONF" ] && [ "$owner" != resolvconf ] && [ "$owner" != systemd-resolved ]; then
                warn "$D_RESOLVCONF is installed, so NetworkManager (rc-manager=auto) gives DNS to it, but $RESOLV is not resolvconf's"
            elif [ -L "$RESOLV" ] && [ "$owner" != systemd-resolved ] && [ "$owner" != resolvconf ]; then
                warn "$RESOLV is a symlink to $(readlink "$RESOLV"): NetworkManager (rc-manager=auto) does not replace it"
            fi ;;
    esac
    if [ -n "$D_DEV" ]; then
        case "$D_STATE" in
            *unmanaged*) warn "$D_DEV is not managed by NetworkManager: it has no DNS servers to write" ;;
            *externally*) warn "$D_DEV is connected outside NetworkManager (\"connected (externally)\", ifupdown or a script): NetworkManager has no DNS servers for it" ;;
        esac
        if [ "$D_IGNORE" = yes ] && [ -z "$D_CONDNS" ]; then
            warn "the connection \"$D_CON_NAME\" ignores the network's DNS servers (ipv4.ignore-auto-dns yes) and has none of its own"
        fi
        if [ "$D_DHCPDNS" = none ] && [ -z "$D_CONDNS" ]; then
            warn "the DHCP server of this network gave no DNS server"
            more "Use public DNS servers: sudo debion-network-check --dns-fallback"
        fi
        if [ -n "$D_NMDNS" ] && ! has_ns; then
            warn "NetworkManager knows DNS servers ($D_NMDNS), but they are not in $RESOLV"
        fi
    fi
    more "Fix: sudo debion-network-check --fix   (repairs this and checks that DNS works)"
}

write_dns_conf() {
    mkdir -p "$NM_CONF_DIR" || return 1
    {
        echo "# Written by debion-network-check: NetworkManager writes /etc/resolv.conf"
        echo "# itself with the DNS servers of the active connections. Remove this file"
        echo "# to go back to NetworkManager's defaults."
        echo "[main]"
        echo "dns=default"
        echo "rc-manager=file"
    } > "$NM_CONF_DIR/90-debion-dns.conf.new" && chmod 644 "$NM_CONF_DIR/90-debion-dns.conf.new" &&
        mv "$NM_CONF_DIR/90-debion-dns.conf.new" "$NM_CONF_DIR/90-debion-dns.conf"
}

# Writes |servers| (at most three: the C library reads no more) into
# /etc/resolv.conf, the way NetworkManager does with rc-manager=file.
write_resolv() {
    doms=""
    [ -n "$D_DEV" ] && doms=$(nmcli -g IP4.DOMAIN device show "$D_DEV" 2>/dev/null | nm_list)
    {
        echo "# Generated by NetworkManager"
        echo "# (written by debion-network-check from NetworkManager's DNS servers)"
        [ -n "$doms" ] && echo "search $doms"
        n=0
        for s in $1; do
            n=$((n + 1)); [ "$n" -le 3 ] && echo "nameserver $s"
        done
    } > "$RESOLV.debion-new" && chmod 644 "$RESOLV.debion-new" && mv "$RESOLV.debion-new" "$RESOLV"
}

restart_nm() {
    if have systemctl && [ -d "$SYSTEMD_RUN" ]; then
        systemctl restart NetworkManager.service 2>/dev/null || nmcli general reload 2>/dev/null
    else
        nmcli general reload 2>/dev/null
    fi
    i=0
    while [ "$i" -lt "$DNS_WAIT" ]; do
        [ "$(nmcli -t -f RUNNING general 2>/dev/null)" = running ] && break
        sleep 1; i=$((i + 1))
    done
}

# Waits up to DNS_WAIT seconds until TEST_HOST resolves.
wait_dns() {
    i=0
    while :; do
        dns_works && return 0
        [ "$i" -ge "$DNS_WAIT" ] && return 1
        sleep 1; i=$((i + 1))
    done
}

dns_success() { echo "DNS works now: $TEST_HOST resolves to $(resolved_to) (name servers: $(resolv_servers))."; }

offer_fallback() {
    [ "${FALLBACK_TRIED:-0}" = 1 ] && return 1
    if [ -n "$D_CON" ] && [ -t 0 ] && [ -t 1 ] && [ -z "${DEBION_NO_ASK:-}" ]; then
        printf 'Use the public DNS servers %s (Cloudflare, Quad9) for "%s"? [y/N] ' "$FALLBACK_DNS" "$D_CON_NAME"
        read -r answer || answer=""
        case "$answer" in
            y|Y|yes|Yes) dns_fallback; return $? ;;
        esac
    fi
    echo "Next: sudo debion-network-check --dns-fallback"
    echo "  (uses the public DNS servers $FALLBACK_DNS on \"${D_CON_NAME:-the active connection}\"; also"
    echo "  Settings > Network > Troubleshooting > Use Public DNS)"
    return 1
}

# Makes NetworkManager write working name servers into /etc/resolv.conf and
# checks that $TEST_HOST resolves. Prints what it did and the truthful
# outcome; 0 when DNS works afterwards.
dns_repair() {
    dns_state
    owner=$(resolv_owner)
    if [ "$owner" = systemd-resolved ] && [ "$D_RESOLVED" != yes ]; then owner=resolved-off; fi
    if ! have nmcli || ! nm_running; then
        echo "DNS is not repaired: NetworkManager is not running (sudo systemctl enable --now NetworkManager)."
        return 1
    fi
    if [ "$D_IMMUTABLE" = yes ]; then
        if have chattr && chattr -i "$RESOLV" 2>/dev/null; then
            echo "$RESOLV was immutable (chattr +i); it can be written again."
        else
            echo "DNS is not repaired: $RESOLV is immutable. Run: sudo chattr -i $RESOLV"
            return 1
        fi
    fi
    # Who should write the file: systemd-resolved when it runs and the file
    # is its stub; otherwise NetworkManager, as a plain file.
    takeover=0
    case "$owner" in
        dangling|missing|empty|dhclient|resolved-off) takeover=1 ;;
        resolvconf) dns_works || takeover=1 ;;
        static) if ! dns_works && [ -n "$D_NMDNS" ]; then takeover=1; fi ;;
    esac
    restart=0
    if [ "$takeover" = 1 ]; then
        if [ -e "$RESOLV" ] || [ -L "$RESOLV" ]; then
            bk="$RESOLV.debion-$(stamp)"
            if ! mv "$RESOLV" "$bk" 2>/dev/null; then
                echo "DNS is not repaired: $RESOLV cannot be moved aside ($(ls -ld "$RESOLV" 2>&1))."
                return 1
            fi
            echo "Saved the old $RESOLV ($owner) as $bk."
        fi
        : > "$RESOLV" && chmod 644 "$RESOLV"
        restart=1
    fi
    if [ "$owner" != systemd-resolved ]; then
        need=0
        case "$D_MODE" in default) ;; *) need=1 ;; esac
        case "$D_RC" in
            file|symlink) ;;
            auto) [ -n "$D_RESOLVCONF" ] && [ "$owner" != resolvconf ] && need=1 ;;
            *) need=1 ;;
        esac
        if [ "$need" = 1 ]; then
            if write_dns_conf; then
                echo "Wrote $NM_CONF_DIR/90-debion-dns.conf (dns=default, rc-manager=file; it was dns=$D_MODE, rc-manager=$D_RC)."
                restart=1
            else
                echo "Could not write $NM_CONF_DIR/90-debion-dns.conf."
            fi
        fi
    fi
    if [ "$restart" = 1 ]; then
        restart_nm
        m=$(nm_main_value dns default); r=$(nm_main_value rc-manager auto)
        if [ "$owner" != systemd-resolved ] && { [ "$m" != default ] || { [ "$r" != file ] && [ "$r" != symlink ] && [ "$r" != auto ]; }; }; then
            echo "Another NetworkManager configuration file still sets dns=$m, rc-manager=$r:"
            echo "  grep -rnE '^(dns|rc-manager)=' /etc/NetworkManager /usr/lib/NetworkManager/conf.d /run/NetworkManager/conf.d"
        fi
        dns_state
    fi
    if [ -n "$D_DEV" ]; then
        pend=" $(pending_handover) $(printf '%s\n' "${conflicts:-}" | tr '\n' ' ') "
        case "$D_STATE" in
            *unmanaged*)
                case "$pend" in
                    *" $D_DEV "*) echo "$D_DEV is still configured by ifupdown; reboot (or run --fix --now) first." ;;
                    *) nmcli device set "$D_DEV" managed yes >/dev/null 2>&1 &&
                           echo "NetworkManager manages $D_DEV now." ;;
                esac ;;
            *externally*)
                nmcli device connect "$D_DEV" >/dev/null 2>&1 &&
                    echo "NetworkManager took over $D_DEV (it was connected outside NetworkManager)." ;;
        esac
        if [ "$D_IGNORE" = yes ] && [ -z "$D_CONDNS" ] && [ -n "$D_CON" ]; then
            nmcli connection modify "$D_CON" ipv4.ignore-auto-dns no >/dev/null 2>&1 &&
                echo "The connection \"$D_CON_NAME\" uses the network's DNS servers again (ipv4.ignore-auto-dns no)."
        fi
        # Apply the profile again (no disconnection); reconnect if that fails.
        if ! nmcli device reapply "$D_DEV" >/dev/null 2>&1 && [ -n "$D_CON" ]; then
            nmcli connection up "$D_CON" >/dev/null 2>&1 || true
        fi
    else
        echo "NetworkManager has no Ethernet or Wi-Fi device with a connection."
    fi
    if wait_dns; then dns_success; return 0; fi
    dns_state
    if ! has_ns && [ -n "$D_NMDNS" ]; then
        if write_resolv "$D_NMDNS"; then
            echo "NetworkManager knows the DNS servers $D_NMDNS but did not write them; they are in $RESOLV now."
            if wait_dns; then dns_success; return 0; fi
        fi
    fi
    # Still not working: say exactly what fails.
    if has_ns; then
        echo "DNS still does not work: $RESOLV lists $(resolv_servers), but $TEST_HOST does not resolve."
        if [ "${FALLBACK_TRIED:-0}" = 1 ]; then
            echo "  Even public DNS servers do not answer: this network blocks DNS (port 53). Ask its"
            echo "  administrator; it may require a proxy (Settings > Network > Proxy)."
            return 1
        fi
        echo "  The DNS server does not answer (down, or blocked by this network)."
    elif [ -z "$D_NMDNS" ]; then
        echo "DNS still does not work: the network gives no DNS server (DHCP on ${D_DEV:-the connection})."
    else
        echo "DNS still does not work: $RESOLV has no name server although NetworkManager has $D_NMDNS."
        echo "  Check: NetworkManager --print-config | grep -E '^(dns|rc-manager)='; ls -l $RESOLV; lsattr $RESOLV"
        return 1
    fi
    offer_fallback
}

# --dns-fallback [off]: public DNS servers on the active connection.
dns_fallback() {
    FALLBACK_TRIED=1
    dns_state
    if [ -z "$D_CON" ]; then
        echo "No active NetworkManager connection to give DNS servers to."
        return 1
    fi
    if [ "$FALLBACK_OFF" = 1 ]; then
        nmcli connection modify "$D_CON" ipv4.dns "" >/dev/null 2>&1 || { echo "nmcli could not change \"$D_CON_NAME\"."; return 1; }
        echo "\"$D_CON_NAME\" uses only the network's DNS servers again."
        nmcli device reapply "$D_DEV" >/dev/null 2>&1 || nmcli connection up "$D_CON" >/dev/null 2>&1 || true
        if wait_dns; then dns_success; return 0; fi
        echo "DNS does not work without the public servers: run sudo debion-network-check --dns-fallback again."
        return 1
    fi
    if ! nmcli connection modify "$D_CON" ipv4.dns "$FALLBACK_DNS" >/dev/null 2>&1; then
        echo "nmcli could not set DNS servers on \"$D_CON_NAME\"."
        return 1
    fi
    echo "\"$D_CON_NAME\" uses the public DNS servers $FALLBACK_DNS (as well as the network's)."
    echo "  Undo: sudo debion-network-check --dns-fallback off"
    dns_repair
}

# Search domains of this network, most specific first, then candidate WPAD
# URLs (RFC draft: wpad.<domain>/wpad.dat walking up to two labels).
wpad_candidates() {
    domains=$(awk '$1 == "search" || $1 == "domain" { for (i = 2; i <= NF; i++) print $i }' "$RESOLV" 2>/dev/null)
    if [ -z "${DEBION_RESOLV_CONF:-}" ] && have nmcli; then
        domains="$domains
$(nmcli -t -g IP4.DOMAIN device show 2>/dev/null | tr '|' '\n')"
    fi
    printf '%s\n' "$domains" | awk '
        # wpad.com.br or wpad.co.uk would ask a stranger for our proxy.
        function public(x) { return x ~ /^(com|net|org|gov|edu|co|ac|or|ne|go|mil|nom|gob|gv|int)\.[a-z][a-z]$/ }
        function emit(x) { if (!(x in seen) && !public(x)) { seen[x] = 1; print "http://wpad." x "/wpad.dat" } }
        NF {
            d = tolower($1); sub(/\.$/, "", d)
            if (d !~ /\./) { emit(d); next }
            # Walk up, but never to wpad.<top-level domain>.
            while (d ~ /\./) { emit(d); sub(/^[^.]*\./, "", d) }
        }'
    echo "http://wpad/wpad.dat"
}

# The PAC URL a DHCP server announced (option 252), if NetworkManager saw one.
dhcp_wpad() {
    have nmcli || return 0
    nmcli -t -f DHCP4 device show 2>/dev/null | sed -n 's/^DHCP4\.OPTION\[[0-9]*\]:wpad = //p; s/^DHCP4\.OPTION\[[0-9]*\]:wpad=//p' | head -n1
}

fetch() {
    # fetch URL [curl options...]: prints the curl exit code (0 on success).
    if ! have curl; then echo 127; return; fi
    url=$1; shift
    curl -sS -o /dev/null --connect-timeout "$TIMEOUT" --max-time $((TIMEOUT * 2)) "$@" "$url" 2>/dev/null
    echo $?
}

find_wpad() {
    u=$(dhcp_wpad)
    if [ -n "$u" ]; then echo "$u"; return 0; fi
    have curl || return 1
    for u in $(wpad_candidates); do
        body=$(curl -sS --noproxy '*' --connect-timeout 3 --max-time 5 "$u" 2>/dev/null | head -c 4096)
        case "$body" in
            *FindProxyForURL*) echo "$u"; return 0 ;;
        esac
    done
    return 1
}

explain_curl() {
    case "$1" in
        0) echo "ok" ;;
        5) echo "proxy-dns:the proxy name cannot be resolved" ;;
        6) echo "dns:the name cannot be resolved (DNS)" ;;
        7) echo "refused:the connection was refused or the host is unreachable" ;;
        28) echo "timeout:the connection timed out (blocked by a firewall?)" ;;
        35) echo "tls:the TLS handshake failed (firewall or broken path MTU?)" ;;
        47|52|55|56) echo "reset:the connection was reset (firewall or broken path MTU?)" ;;
        51|58|59|60|77|83|90|91) echo "cert:the certificate was not accepted (wrong clock or a network that intercepts HTTPS)" ;;
        97) echo "proxy:the proxy handshake failed" ;;
        127) echo "nocurl:curl is not installed" ;;
        *) echo "other:curl error $1" ;;
    esac
}

# ---------------------------------------------------------------- proxies

# The desktop proxy (GSettings, read by Firefox, GTK and SDE) as
# "MODE URL": none, manual http://host:port, auto PAC-URL (may be empty).
desktop_proxy() {
    # root (sudo/pkexec) has its own, unrelated GSettings.
    if ! have gsettings || [ "${DEBION_UID:-$(id -u)}" = 0 ]; then echo "unknown"; return; fi
    m=$(gsettings get org.gnome.system.proxy mode 2>/dev/null | tr -d "'")
    case "$m" in
        manual)
            h=$(gsettings get org.gnome.system.proxy.https host 2>/dev/null | tr -d "'")
            p=$(gsettings get org.gnome.system.proxy.https port 2>/dev/null)
            if [ -z "$h" ]; then
                h=$(gsettings get org.gnome.system.proxy.http host 2>/dev/null | tr -d "'")
                p=$(gsettings get org.gnome.system.proxy.http port 2>/dev/null)
            fi
            if [ -n "$h" ]; then echo "manual http://$h:${p:-8080}"; else echo "manual"; fi ;;
        auto) echo "auto $(gsettings get org.gnome.system.proxy autoconfig-url 2>/dev/null | tr -d "'")" ;;
        "") echo "unknown" ;;
        *) echo "none" ;;
    esac
}

apt_proxy() {
    have apt-config || return 0
    apt-config dump 2>/dev/null | sed -n 's/^Acquire::https\{0,1\}::Proxy "\(.*\)";$/\1/p' | grep -v '^DIRECT$\|^false$' | head -n1
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n\r')"; }

clock_skew() {
    # Seconds between this clock and the Date header of an HTTP server
    # (through the user's proxy variables, if any). Empty when unknown.
    have curl || return 0
    d=$(curl -sSI --connect-timeout "$TIMEOUT" --max-time $((TIMEOUT * 2)) "http://$TEST_HOST/" 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: //p' | head -n1)
    [ -n "$d" ] || return 0
    remote=$(date -d "$d" +%s 2>/dev/null) || return 0
    echo $(( $(date +%s) - remote ))
}

abs() { case "$1" in -*) echo "${1#-}" ;; *) echo "$1" ;; esac; }

# ------------------------------------------------------ automatic repair
#
# --boot-repair (debion-network-repair.service, every boot; the SDE panel
# through polkit) and --postinst-repair (debion-desktop-base's postinst) only
# make changes that cannot break a working network and that an administrator
# did not choose against:
#   - an /etc/resolv.conf that cannot work (missing, a dangling symlink, the
#     stub of a stopped systemd-resolved, left behind by the installer's
#     dhclient) is moved aside so that NetworkManager writes it;
#   - NetworkManager is told to write it (conf.d/90-debion-dns.conf) when its
#     configuration would not, unless /etc/NetworkManager sets dns= or
#     rc-manager= itself (then only --fix, run by an administrator, does);
#   - Ethernet and Wi-Fi devices that nothing else configures (not in
#     /etc/network/interfaces, not in unmanaged-devices, no systemd-networkd)
#     are managed by NetworkManager;
#   - profiles imported from /etc/network/interfaces connect automatically,
#     and an Ethernet port with a cable but no automatic profile gets one;
#   - /etc/resolv.conf is readable by everyone.
# Then it checks that DNS works. Everything is logged to $LOGFILE. Static,
# bridge, bond, VLAN and wpa-conf setups are never touched.

repairs=0
rlog() {
    printf '%s\n' "$*"
    { printf '%s %s: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$MODE" "$*" >> "$LOGFILE"; } 2>/dev/null || true
}
repaired() { repairs=$((repairs + 1)); rlog "$@"; }

# A key of /etc/debion/network.conf ("" when not set).
conf_value() {
    awk -v s="$1" -v k="$2" '
        /^[ \t]*[#;]/ { next }
        /^[ \t]*\[/ { sec = $0; gsub(/[][ \t]/, "", sec); next }
        sec == s && index($0, "=") {
            n = index($0, "="); key = substr($0, 1, n - 1); gsub(/[ \t]/, "", key)
            if (key == k) { v = substr($0, n + 1); gsub(/^[ \t]+|[ \t]+$/, "", v) }
        }
        END { print v }' "$NET_CONF" 2>/dev/null
}
auto_repair_enabled() {
    case "$(conf_value network auto_repair)" in
        false|no|off|0|False|No|Off) return 1 ;;
    esac
    return 0
}

in_chroot() {
    case "${DEBION_CHROOT:-}" in 1) return 0 ;; 0) return 1 ;; esac
    have ischroot && ischroot 2>/dev/null
}

# The administrator set NetworkManager's DNS handling (dns= or rc-manager=
# in /etc/NetworkManager, other than in our own file).
admin_dns_set() {
    for f in "$NM_MAIN_CONF" "$NM_CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        [ "${f##*/}" = 90-debion-dns.conf ] && continue
        grep -qsE '^[ \t]*(dns|rc-manager)[ \t]*=' "$f" && return 0
    done
    return 1
}

# NetworkManager's configuration (see dns_state) would not put the name
# servers into a plain /etc/resolv.conf.
nm_wont_write() {
    case "$D_MODE" in
        none) return 0 ;;
        systemd-resolved) [ "$D_RESOLVED" = yes ] || return 0 ;;
    esac
    case "$D_RC" in
        unmanaged|netconfig|resolvconf) return 0 ;;
        auto) [ -n "$D_RESOLVCONF" ] && return 0 ;;
    esac
    return 1
}

# Interfaces that /etc/network/interfaces mentions at all.
ifupdown_mentions() {
    interfaces_files | while IFS= read -r f; do cat "$f" 2>/dev/null; echo; done |
        awk '{ sub(/^[ \t]+/, "") } $1 == "iface" || $1 ~ /^(auto|allow-)/ { for (i = 2; i <= NF; i++) if ($i != "lo") print $i }' |
        sort -u
}

# Moves an /etc/resolv.conf that cannot work aside and leaves an empty
# file that NetworkManager writes into.
replace_resolv() {
    bk="$RESOLV.debion-$(stamp)"
    if [ -e "$RESOLV" ] || [ -L "$RESOLV" ]; then
        mv "$RESOLV" "$bk" 2>/dev/null || { rlog "could not move $RESOLV aside"; return 1; }
        : > "$RESOLV" && chmod 644 "$RESOLV"
        repaired "$RESOLV ($1) cannot work; NetworkManager writes it now (old file: $bk)"
    else
        : > "$RESOLV" && chmod 644 "$RESOLV"
        repaired "$RESOLV was missing; NetworkManager writes it now"
    fi
}

repair_dns_config() {
    dns_state
    owner=$(resolv_owner)
    [ "$owner" = systemd-resolved ] && [ "$D_RESOLVED" != yes ] && owner=resolved-off
    case "$owner" in
        systemd-resolved) return 0 ;;          # systemd-resolved runs and owns it
        resolvconf) has_ns && return 0 ;;      # resolvconf works
    esac
    nm_will=1
    if nm_wont_write; then
        if admin_dns_set; then
            case "$owner" in
                dangling|missing|empty|resolved-off)
                    rlog "$RESOLV has no name server, and /etc/NetworkManager sets dns=$D_MODE, rc-manager=$D_RC:"
                    rlog "  not changed automatically; run: sudo debion-network-check --fix" ;;
            esac
            return 0
        fi
        if write_dns_conf; then
            NM_CHANGED=1
            repaired "NetworkManager writes $RESOLV now ($NM_CONF_DIR/90-debion-dns.conf; it was dns=$D_MODE, rc-manager=$D_RC)"
        else
            nm_will=0
        fi
    fi
    if [ "$nm_will" = 1 ]; then
        case "$owner" in
            dangling) replace_resolv "a symlink to the missing $(readlink "$RESOLV")" ;;
            resolved-off) replace_resolv "the stub of systemd-resolved, which is not running" ;;
            missing) replace_resolv missing ;;
            dhclient)
                # Written by the installer's dhclient; nobody renews it.
                if [ -z "$(dhcp_clients)" ] && have nmcli && nm_running; then
                    replace_resolv "written by a DHCP client outside NetworkManager"
                    NM_CHANGED=1
                fi ;;
        esac
    fi
    if [ -f "$RESOLV" ] && [ ! -L "$RESOLV" ]; then
        case "$(stat -c %a "$RESOLV" 2>/dev/null)" in
            *[4567]|"") ;;
            *) chmod a+r "$RESOLV" && repaired "$RESOLV is readable by everyone again" ;;
        esac
    fi
}

reload_nm_now() {
    if have systemctl && [ -d "$SYSTEMD_RUN" ]; then
        systemctl reload NetworkManager.service 2>/dev/null || nmcli general reload 2>/dev/null || true
    else
        nmcli general reload 2>/dev/null || true
    fi
}

# Profiles that debion-network-check imported connect automatically.
repair_imported_profiles() {
    [ -d "$NMCONN" ] || return 0
    for f in "$NMCONN"/*.nmconnection; do
        [ -f "$f" ] || continue
        grep -q '^# Imported from /etc/network/interfaces by debion-network-check' "$f" 2>/dev/null || continue
        grep -qE '^autoconnect[ \t]*=[ \t]*(false|no|0)' "$f" || continue
        sed -i 's/^autoconnect[ \t]*=.*/autoconnect=true/' "$f" &&
            repaired "the imported profile ${f##*/} connects automatically again"
        PROFILES_CHANGED=1
    done
}

# Only real network cards: veth (containers), vboxnet and other virtual
# devices are unmanaged on purpose, as is anything udev marks NM_UNMANAGED.
real_card() {
    [ -d "$SYSNET" ] || return 0
    [ -e "$SYSNET/$1/device" ] || [ -L "$SYSNET/$1/device" ] || return 1
    if have udevadm && udevadm info -q property -p "$SYSNET/$1" 2>/dev/null | grep -q '^NM_UNMANAGED=1'; then
        return 1
    fi
    return 0
}

# Ethernet/Wi-Fi cards that NetworkManager does not manage.
unmanaged_cards() {
    have nmcli || return 0
    nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '($2 == "ethernet" || $2 == "wifi") && $3 == "unmanaged" { print $1 }' |
        while IFS= read -r d; do real_card "$d" && printf '%s\n' "$d"; done
}

repair_devices() {
    have nmcli && nm_running || return 0
    if unit_active systemd-networkd.service; then
        rlog "systemd-networkd runs as well: network devices are left alone"
        return 0
    fi
    mentioned=" $(ifupdown_mentions | tr '\n' ' ') $(pending_handover) "
    unmanaged_conf=$("$NM_BIN" --print-config 2>/dev/null | sed -n 's/^[ \t]*unmanaged-devices[ \t]*=[ \t]*//p' | tr '\n' ';')
    for line in $(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | tr ' ' '_'); do
        dev=${line%%:*}; rest=${line#*:}; type=${rest%%:*}; state=${rest#*:}
        case "$type" in ethernet|wifi) ;; *) continue ;; esac
        real_card "$dev" || continue
        case "$state" in
            unmanaged)
                case "$mentioned" in *" $dev "*) continue ;; esac
                # Deliberately unmanaged in NetworkManager's configuration.
                case ";$unmanaged_conf;" in
                    *"$dev"*|*'*'*|*mac:*|*type:*|*driver:*|*except:*) continue ;;
                esac
                nmcli device set "$dev" managed yes >/dev/null 2>&1 &&
                    repaired "NetworkManager manages $dev now (it was unmanaged)" ;;
            disconnected)
                [ "$type" = ethernet ] || continue
                # A cable is in (otherwise "unavailable"): is there a profile
                # that connects by itself?
                profiles=$(nmcli -t -f UUID,TYPE,AUTOCONNECT connection show 2>/dev/null)
                printf '%s\n' "$profiles" | grep -q ':802-3-ethernet:yes$' && continue
                for u in $(printf '%s\n' "$profiles" | sed -n 's/^\(.*\):802-3-ethernet:no$/\1/p'); do
                    ifn=$(nmcli -g connection.interface-name connection show "$u" 2>/dev/null)
                    [ -z "$ifn" ] || [ "$ifn" = "$dev" ] || continue
                    nmcli connection modify "$u" connection.autoconnect yes >/dev/null 2>&1 &&
                        repaired "the wired profile \"$(nmcli -g connection.id connection show "$u" 2>/dev/null)\" connects automatically again"
                    break
                done
                nmcli -w 8 device connect "$dev" >/dev/null 2>&1 &&
                    repaired "connected $dev (a cable is plugged in, but nothing connected it)" ;;
        esac
    done
}

# Waits until NetworkManager has a connection, then until names resolve.
verify_dns() {
    have nmcli && nm_running || { rlog "NetworkManager is not running: DNS is not checked"; return 0; }
    i=0
    while :; do
        case "$(nmcli -t -f STATE general 2>/dev/null)" in connected*) break ;; esac
        if [ "$i" -ge "$DNS_WAIT" ]; then
            rlog "no network connection yet: the desktop checks DNS again when it connects"
            return 0
        fi
        sleep 1; i=$((i + 1))
    done
    if wait_dns; then rlog "$(dns_success)"; return 0; fi
    dns_state
    if ! has_ns && [ -n "$D_NMDNS" ] && ! { nm_wont_write && admin_dns_set; }; then
        write_resolv "$D_NMDNS" &&
            repaired "NetworkManager knows the DNS servers $D_NMDNS but did not write them; they are in $RESOLV now"
        if wait_dns; then rlog "$(dns_success)"; return 0; fi
    fi
    if has_ns; then
        rlog "DNS does not work yet: $RESOLV lists $(resolv_servers), but $TEST_HOST does not resolve"
    else
        rlog "DNS does not work yet: $RESOLV has no name server (NetworkManager has: ${D_NMDNS:-none})"
    fi
    rlog "  run: sudo debion-network-check --fix"
    return 1
}

safe_repair() {
    NM_CHANGED=0; PROFILES_CHANGED=0
    if in_chroot; then
        # An image build: /etc/resolv.conf belongs to the build host. The
        # boot service repairs the installed system.
        repair_imported_profiles
        return 0
    fi
    repair_dns_config
    repair_imported_profiles
    if have nmcli && nm_running; then
        if [ "$NM_CHANGED" = 1 ]; then
            reload_nm_now
            dns_state
            # NetworkManager writes resolv.conf when it applies a connection.
            if [ -n "$D_DEV" ]; then nmcli device reapply "$D_DEV" >/dev/null 2>&1 || true; fi
        fi
        if [ "$PROFILES_CHANGED" = 1 ]; then nmcli connection reload >/dev/null 2>&1 || true; fi
        repair_devices
    fi
    return 0
}

# ========================================================== building blocks
case "$MODE" in
    list-convertible) ifupdown_dhcp_ifaces; exit 0 ;;
    convert-interfaces) convert_file "$IFACES" "$(ifupdown_dhcp_ifaces | tr '\n' ' ')"; exit 0 ;;
    wifi-profiles) wifi_profiles "$(ifupdown_dhcp_ifaces | tr '\n' ' ')" "${1:-.}"; exit 0 ;;
    dhcp-clients) dhcp_clients; exit 0 ;;
    wpad-candidates) wpad_candidates; exit 0 ;;
    explain-curl) explain_curl "${1:-0}"; exit 0 ;;
    resolv-owner) resolv_owner; exit 0 ;;
    wpad) find_wpad || exit 1; exit 0 ;;
esac

# ------------------------------------------------------ public DNS servers
if [ "$MODE" = dns-fallback ]; then
    if [ "$(id -u)" != 0 ]; then echo "debion-network-check --dns-fallback must run as root (sudo)." >&2; exit 1; fi
    if dns_fallback; then exit 0; fi
    exit 4
fi

# ---------------------------------------------- package scripts: DNS
# Called by debion-desktop-base's postinst (which reloads NetworkManager
# afterwards): when /etc/resolv.conf has no name server at all and nothing
# else is meant to write it, let NetworkManager write it as a plain file.
# An administrator's own dns= or rc-manager= setting is left alone.
if [ "$MODE" = postinst-dns ]; then
    case "$(resolv_owner)" in
        dangling|missing|empty) ;;
        systemd-resolved) unit_active systemd-resolved.service && exit 0 ;;
        *) exit 0 ;;
    esac
    [ -x "$NM_BIN" ] || exit 0
    [ -e "$NM_CONF_DIR/90-debion-dns.conf" ] && exit 0
    if admin_dns_set; then
        echo "debion-desktop-base: $RESOLV has no name server, and /etc/NetworkManager sets dns= or rc-manager=;"
        echo "  if names cannot be resolved, run 'sudo debion-network-check --fix'."
        exit 0
    fi
    if [ -L "$RESOLV" ] || [ ! -e "$RESOLV" ]; then
        { [ -L "$RESOLV" ] && mv "$RESOLV" "$RESOLV.debion-$(stamp)"; } || true
        : > "$RESOLV" && chmod 644 "$RESOLV"
    fi
    write_dns_conf && echo "debion-desktop-base: $RESOLV had no name server; NetworkManager writes it now ($NM_CONF_DIR/90-debion-dns.conf)"
    exit 0
fi

# --------------------------------------------- automatic (unattended) repair
# --boot-repair: debion-network-repair.service at every boot, and the SDE
# panel (through /usr/libexec/debion-network-repair and polkit) when DNS
# fails after login. --postinst-repair [--first-install]: the package
# scripts. Both always exit 0 when they ran (a network that is down is not
# an error of the unit); the output (and $LOGFILE) says what happened.
if [ "$MODE" = boot-repair ] || [ "$MODE" = postinst-repair ]; then
    if [ "$(id -u)" != 0 ]; then echo "debion-network-check --$MODE must run as root." >&2; exit 1; fi
    if ! auto_repair_enabled; then
        [ "$MODE" = boot-repair ] && rlog "automatic repair is off ([network] auto_repair=false in $NET_CONF)"
        exit 0
    fi
    [ -x "$NM_BIN" ] || exit 0
    # At boot the whole run stays within the unit's 30 s.
    [ "$MODE" = boot-repair ] && DNS_WAIT=${DEBION_DNS_WAIT:-6}
    safe_repair
    if [ "$MODE" = boot-repair ]; then
        verify_dns || true
        [ "$repairs" = 0 ] && rlog "nothing to repair"
        exit 0
    fi
    # A new installation turns network time on (HTTPS fails with a wrong
    # clock); an upgrade keeps the administrator's choice.
    if [ "$FIRST_INSTALL" = 1 ] && have timedatectl && [ -d "$SYSTEMD_RUN" ] && ! in_chroot &&
       [ "$(timedatectl show -p NTP --value 2>/dev/null)" = no ] &&
       have_timesyncd; then
        timedatectl set-ntp true 2>/dev/null && repaired "network time (systemd-timesyncd) is on"
    fi
    if ! in_chroot && have nmcli && nm_running && [ "$(nmcli -t -f STATE general 2>/dev/null)" = connected ]; then
        DNS_WAIT=${DEBION_DNS_WAIT:-3}
        if wait_dns; then
            [ "$repairs" = 0 ] || rlog "DNS works: $TEST_HOST resolves (name servers: $(resolv_servers))"
        else
            rlog "DNS does not work yet; run: sudo debion-network-check --fix"
        fi
    fi
    exit 0
fi

# ------------------------------------------------------------ APT proxy
if [ "$MODE" = apt-proxy ]; then
    if [ "$(id -u)" != 0 ]; then echo "debion-network-check --apt-proxy must run as root." >&2; exit 1; fi
    conf=${DEBION_APT_PROXY_CONF:-/etc/apt/apt.conf.d/80debion-proxy}
    case "$APT_PROXY_ARG" in
        none|"") rm -f "$conf"; echo "APT connects directly."; exit 0 ;;
    esac
    # Only plain proxy URLs: nothing that could end the APT string. One line
    # only: grep matches line by line, so "URL<newline>APT::Update::..."
    # would otherwise pass with its first line and add APT options (run as
    # root) after it.
    nl='
'
    case "$APT_PROXY_ARG" in
        *"$nl"*|*"$(printf '\r')"*) echo "not a proxy URL: it has more than one line" >&2; exit 2 ;;
    esac
    if ! printf '%s\n' "$APT_PROXY_ARG" | grep -Eqx 'https?://([A-Za-z0-9._~%!$&()*+,;=-]+(:[A-Za-z0-9._~%!$&()*+,;=-]*)?@)?[A-Za-z0-9.-]+(:[0-9]{1,5})?/?'; then
        echo "not a proxy URL: $APT_PROXY_ARG" >&2; exit 2
    fi
    {
        echo "// Written by debion-network-check (Control Center > Network > Proxy)."
        echo "Acquire::http::Proxy \"$APT_PROXY_ARG\";"
        echo "Acquire::https::Proxy \"$APT_PROXY_ARG\";"
    } > "$conf.new" && chmod 644 "$conf.new" && mv "$conf.new" "$conf"
    echo "APT uses the proxy $APT_PROXY_ARG"
    exit 0
fi

# ------------------------------------------------------- package scripts
# Called by debion-desktop-base's postinst, once per system (first
# installation, or the first upgrade that has this code): moves interfaces
# that the installer configured with plain DHCP (or a wpa-ssid/wpa-psk
# Wi-Fi) to NetworkManager. Nothing running is changed: the network keeps
# working for the rest of the installation (and over SSH), and the next
# boot brings the interfaces up with NetworkManager only, so that there is
# never a second DHCP client. Opt out: /etc/debion/keep-ifupdown.
# Exit status 3: NetworkManager is not installed yet (try again later).
if [ "$MODE" = handover ]; then
    [ -e "${DEBION_KEEP_FILE:-/etc/debion/keep-ifupdown}" ] && exit 0
    [ -x "$NM_BIN" ] || exit 3
    # A dangling /etc/resolv.conf (systemd-resolved removed) cannot work
    # for anyone; an empty file is what NetworkManager writes into.
    if [ "$(resolv_owner)" = dangling ]; then
        mv "$RESOLV" "$RESOLV.debion-$(stamp)" && : > "$RESOLV" && chmod 644 "$RESOLV"
        echo "debion-desktop-base: $RESOLV pointed nowhere; NetworkManager writes it now"
    fi
    [ -f "$IFACES" ] || exit 0
    list=$(ifupdown_dhcp_ifaces | tr '\n' ' ')
    list=${list% }
    [ -n "$list" ] || exit 0
    echo "debion-desktop-base: handing $list from ifupdown to NetworkManager"
    # Until the next boot, ifupdown's DHCP client still owns the
    # interfaces: keep NetworkManager away from them even if it is reloaded
    # or restarted now, so that there are never two DHCP clients. /run is
    # emptied at boot, and then NetworkManager alone manages them.
    dest="$BACKUPS/$(stamp)"
    if mkdir -p "$NM_RUN_CONF" 2>/dev/null; then
        spec=""
        for n in $list; do spec="${spec:+$spec;}interface-name:$n"; done
        printf '%s\n' "# debion-desktop-base: ifupdown still runs these until the next boot." \
            "# backup: $dest/$(printf '%s' "$IFACES" | tr / _)" \
            "[keyfile]" "unmanaged-devices+=$spec" > "$NM_RUN_CONF/90-debion-handover.conf"
    fi
    handover "$list" 0 "$dest" | sed 's/^/  /'
    echo "  This takes effect at the next boot (no connection is dropped now)."
    echo "  Undo: restore the backup above; opt out: touch /etc/debion/keep-ifupdown"
    exit 0
fi

# ================================================================ checks
conflicts=$(ifupdown_dhcp_ifaces)
clients=$(dhcp_clients)
resolv=$(resolv_owner)

if [ "$MODE" = postinst ]; then
    if [ -n "$conflicts" ] && have nmcli; then
        names=$(printf '%s\n' "$conflicts" | tr '\n' ' ')
        echo "debion-desktop-base: /etc/network/interfaces configures $names; NetworkManager"
        echo "  (the SDE panel) cannot manage them and their routes can hide Wi-Fi."
        echo "  Run 'sudo debion-network-check --fix' to hand them to NetworkManager."
    fi
    exit 0
fi

# --------------------------------------------------------- quick (JSON)
if [ "$MODE" = quick ]; then
    route=false; dns=false
    have ip && [ -n "$(ip -4 route show default 2>/dev/null)$(ip -6 route show default 2>/dev/null)" ] && route=true
    getent ahosts "$TEST_HOST" >/dev/null 2>&1 && dns=true
    nmstate=""; have nmcli && nmstate=$(nmcli -t -f STATE,CONNECTIVITY general 2>/dev/null | head -n1)
    dp=$(desktop_proxy); pmode=${dp%% *}; purl=""; [ "$dp" != "$pmode" ] && purl=${dp#* }
    http_d=$(fetch "http://$TEST_HOST/debian/" --noproxy '*')
    https_d=$(fetch "https://$TEST_HOST/debian/" --noproxy '*')
    https_p=""
    proxy_used=""
    if [ "$pmode" = manual ] && [ -n "$purl" ]; then proxy_used=$purl
    elif [ -n "${https_proxy:-${HTTPS_PROXY:-}}" ]; then proxy_used=${https_proxy:-${HTTPS_PROXY:-}}
    fi
    [ -n "$proxy_used" ] && https_p=$(fetch "https://$TEST_HOST/debian/" -x "$proxy_used")
    wpad=""; aptp=$(apt_proxy)
    skew=""
    if [ "$https_d" != 0 ] && [ "${https_p:-1}" != 0 ]; then
        wpad=$(find_wpad || true)
        case "$(explain_curl "$https_d")" in cert:*) skew=$(clock_skew) ;; esac
    fi
    verdict=ok
    if [ "$route" = false ]; then verdict=no-route
    elif [ "$dns" = false ] && [ "$http_d" = 6 ]; then verdict=no-dns
    elif [ "$https_d" = 0 ] || [ "${https_p:-1}" = 0 ]; then verdict=ok
    elif [ -n "$skew" ] && [ "$(abs "$skew")" -gt 300 ]; then verdict=clock
    else
        case "$(explain_curl "$https_d")" in
            cert:*) verdict=tls-intercepted ;;
            nocurl:*) verdict=unknown ;;
            *) if [ "$http_d" = 0 ] || [ -n "$wpad$aptp" ]; then verdict=proxy-required; else verdict=offline; fi ;;
        esac
    fi
    printf '{"version":%s,"verdict":%s,"nm":%s,"default_route":%s,"dns":%s,' "$VERSION" "$(json_str "$verdict")" "$(json_str "$nmstate")" "$route" "$dns"
    printf '"http_direct":%s,"https_direct":%s,"https_proxy":%s,' "$http_d" "$https_d" "${https_p:-null}"
    # Something --boot-repair / --fix repairs (the panel offers "Fix now").
    repairable=false
    case "$resolv" in
        dangling|missing|resolved-off|dhclient) repairable=true ;;
        empty) [ "$dns" = false ] && repairable=true ;;
        systemd-resolved) unit_active systemd-resolved.service || repairable=true ;;
    esac
    [ -n "$conflicts" ] && [ ! -e "${DEBION_KEEP_FILE:-/etc/debion/keep-ifupdown}" ] && repairable=true
    [ -n "$(unmanaged_cards)" ] && repairable=true
    auto=true; auto_repair_enabled || auto=false
    printf '"proxy_mode":%s,"proxy_url":%s,"wpad_url":%s,"apt_proxy":%s,"clock_skew":%s,"repairable":%s,"auto_repair":%s}\n' \
        "$(json_str "$pmode")" "$(json_str "$purl")" "$(json_str "$wpad")" "$(json_str "$aptp")" "${skew:-null}" "$repairable" "$auto"
    exit 0
fi

say "DebION network check"
say ""
say "Services"
if ! have nmcli; then
    warn "NetworkManager is not installed: sudo apt install network-manager"
elif nm_running; then
    ok "NetworkManager is running"
else
    warn "NetworkManager is not running: sudo systemctl enable --now NetworkManager"
fi
if unit_active systemd-networkd.service; then
    warn "systemd-networkd is running too: two network managers fight over the same interfaces"
    more "Keep one: sudo systemctl disable --now systemd-networkd.service"
fi

# ---------------------------------------------------- ifupdown vs NetworkManager
if [ -n "$conflicts" ]; then
    names=$(printf '%s\n' "$conflicts" | tr '\n' ' ')
    warn "/etc/network/interfaces configures: $names"
    more "NetworkManager leaves these unmanaged ([ifupdown] managed=false), so the"
    more "panel cannot control them, and their default route (metric 0) wins over"
    more "Wi-Fi/Ethernet connected by NetworkManager: \"connected, no internet\"."
    more "Fix: sudo debion-network-check --fix   (backs the files up first)"
else
    ok "no DHCP/Wi-Fi interfaces in /etc/network/interfaces compete with NetworkManager"
fi
pending=$(pending_handover)
if [ -n "$pending" ]; then
    info "$pending move from ifupdown to NetworkManager at the next boot (or: sudo debion-network-check --fix)"
fi

dup=""
if [ -n "$clients" ]; then
    managed=""
    have nmcli && managed=$(nmcli -t -f DEVICE,STATE device 2>/dev/null | awk -F: '$2 != "unmanaged" && $2 != "unavailable" {print $1}' | tr '\n' ' ')
    dup=$(printf '%s\n' "$clients" | while read -r pid client dev; do
        case " $managed " in
            *" $dev "*) echo "$pid $client $dev" ;;
            *) [ "$dev" = "*" ] && [ -n "${managed% }" ] && echo "$pid $client $dev" ;;
        esac
    done)
    if [ -n "$dup" ]; then
        old_ifs=$IFS; IFS='
'
        for line in $dup; do
            IFS=$old_ifs
            set -- $line
            warn "a second DHCP client ($2, PID $1) runs on $3, which NetworkManager also manages"
        done
        IFS=$old_ifs
        more "Two DHCP clients mean two leases, competing routes and a resolv.conf that changes under you."
        more "Fix: sudo debion-network-check --fix   (takes the interface down in ifupdown)"
    else
        info "other DHCP clients: $(printf '%s\n' "$clients" | awk '{print $2 " on " $3}' | tr '\n' ' ')"
    fi
fi

# --------------------------------------------------------------- routes
say ""
say "Routes"
if have ip; then
    n=$(ip -4 route show default 2>/dev/null | grep -c . || true)
    if [ "$n" = 0 ]; then
        warn "no IPv4 default route (no gateway): the network is connected but cannot reach the internet"
    elif [ "$n" -gt 1 ]; then
        warn "$n IPv4 default routes; the lowest metric wins:"
        ip -4 route show default 2>/dev/null | sed 's/^/          /'
    else
        ok "one IPv4 default route: $(ip -4 route show default 2>/dev/null)"
    fi
fi

# --------------------------------------------------------------- DNS
say ""
say "Name resolution"
case "$resolv" in
    dangling) warn "$RESOLV points to $(readlink "$RESOLV"), which does not exist (DNS cannot work)" ;;
    missing) warn "$RESOLV is missing" ;;
    empty) warn "$RESOLV has no name server: names cannot be resolved" ;;
    systemd-resolved)
        if unit_active systemd-resolved.service; then ok "$RESOLV is managed by systemd-resolved"
        else resolv=resolved-off; warn "$RESOLV uses systemd-resolved, but systemd-resolved is not running"; fi ;;
    networkmanager) ok "$RESOLV is written by NetworkManager" ;;
    resolvconf) ok "$RESOLV is managed by resolvconf (NetworkManager feeds it)" ;;
    dhclient) warn "$RESOLV was written by a DHCP client outside NetworkManager"
              more "It is rewritten whenever that client renews its lease." ;;
    static) info "$RESOLV is a plain file that NetworkManager did not write" ;;
esac
if [ -e "$RESOLV" ] && [ ! -r "$RESOLV" ]; then
    warn "$RESOLV is not readable by $(id -un): programs run by this user cannot resolve names"
fi
if have nmcli && nm_running && [ -f "$RESOLV" ]; then
    nmdns=$(nmcli -t -g IP4.DNS device show 2>/dev/null | tr '|' '\n' | grep . | sort -u | tr '\n' ' ')
    rdns=$(awk '$1 == "nameserver" {print $2}' "$RESOLV" 2>/dev/null | sort -u | tr '\n' ' ')
    if [ -n "$nmdns" ] && [ "$resolv" != systemd-resolved ] && [ "$resolv" != resolvconf ]; then
        missing=""
        for s in $nmdns; do case " $rdns " in *" $s "*) ;; *) missing="$missing $s" ;; esac; done
        if [ -n "$missing" ] && [ -n "$rdns" ]; then
            warn "NetworkManager's DNS servers ($nmdns) are not in $RESOLV ($rdns): another program wrote it"
        fi
    fi
fi
if grep -q '^hosts:' /etc/nsswitch.conf 2>/dev/null; then
    hosts=$(sed -n 's/^hosts:[ \t]*//p' /etc/nsswitch.conf)
    case " $hosts " in
        *" dns "*|*" resolve"*) : ;;
        *) warn "/etc/nsswitch.conf does not use DNS for host names (hosts: $hosts)" ;;
    esac
fi
dns_ok=1
if getent ahosts "$TEST_HOST" >/dev/null 2>&1; then
    ok "$TEST_HOST resolves: $(getent ahosts "$TEST_HOST" | awk '{print $1}' | sort -u | head -n4 | tr '\n' ' ')"
else
    dns_ok=0
    warn "$TEST_HOST does not resolve (DNS does not work for this user)"
    dns_findings
fi

# ---------------------------------------------------------------- clock
say ""
say "Time"
if have timedatectl; then
    sync=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)
    ntp=$(timedatectl show -p NTP --value 2>/dev/null || true)
    if [ "$sync" = yes ]; then ok "the clock is synchronized (NTP)"
    elif [ "$ntp" = no ]; then warn "network time is off: HTTPS fails when the clock is wrong. Fix: sudo timedatectl set-ntp true"
    elif ! [ -x /lib/systemd/systemd-timesyncd ] && ! [ -x /usr/lib/systemd/systemd-timesyncd ] &&
         ! have chronyd && ! have ntpd && ! have ntpsec; then
        warn "no time service is installed: sudo apt install systemd-timesyncd"
    else info "the clock is not synchronized yet (NTP may be blocked on this network)"
    fi
fi
skew=$(clock_skew)
if [ -n "$skew" ]; then
    if [ "$(abs "$skew")" -gt 300 ]; then
        warn "the clock is off by $skew s compared to $TEST_HOST: certificates look invalid, so HTTPS fails"
        more "Fix: sudo debion-network-check --fix (sets the time once and turns on NTP)"
    else ok "the clock agrees with $TEST_HOST (${skew} s)"
    fi
fi
[ -s /etc/ssl/certs/ca-certificates.crt ] || warn "ca-certificates is missing: sudo apt install ca-certificates"

# -------------------------------------------------------- reachability
say ""
say "Internet access (as Firefox would try it)"
dp=$(desktop_proxy); pmode=${dp%% *}; purl=""; [ "$dp" != "$pmode" ] && purl=${dp#* }
aptp=$(apt_proxy)
http_d=$(fetch "http://$TEST_HOST/debian/" --noproxy '*')
https_d=$(fetch "https://$TEST_HOST/debian/" --noproxy '*')
if [ "$http_d" = 127 ]; then
    info "curl is not installed; reachability is not checked (sudo apt install curl)"
else
    [ "$http_d" = 0 ] && ok "direct HTTP to $TEST_HOST works (this is what NetworkManager's check and APT use)" \
                      || warn "direct HTTP to $TEST_HOST fails: $(explain_curl "$http_d" | cut -d: -f2)"
    if [ "$https_d" = 0 ]; then
        ok "direct HTTPS to $TEST_HOST works"
    else
        warn "direct HTTPS to $TEST_HOST fails: $(explain_curl "$https_d" | cut -d: -f2)"
        case "$(explain_curl "$https_d")" in
            cert:*)
                issuer=$(curl -k -v --noproxy '*' --max-time $((TIMEOUT * 2)) -o /dev/null "https://$TEST_HOST/" 2>&1 | sed -n 's/^\*[ \t]*issuer: //p' | head -n1)
                [ -n "$issuer" ] && more "The certificate was issued by: $issuer"
                more "If that is not a public authority (Let's Encrypt, GlobalSign...), this network"
                more "intercepts HTTPS: import your organization's CA certificate into Firefox"
                more "(Settings > Privacy & Security > Certificates) and into /usr/local/share/ca-certificates." ;;
            timeout:*|refused:*|reset:*|tls:*)
                if [ "$http_d" = 0 ]; then
                    more "Plain HTTP works but HTTPS does not: the network lets HTTP through a"
                    more "transparent proxy and expects browsers to use its proxy for everything else."
                fi ;;
        esac
    fi
    if [ "$pmode" = manual ] && [ -n "$purl" ]; then
        r=$(fetch "https://$TEST_HOST/debian/" -x "$purl")
        [ "$r" = 0 ] && ok "HTTPS through the desktop proxy $purl works" \
                     || warn "HTTPS through the desktop proxy $purl fails: $(explain_curl "$r" | cut -d: -f2)"
    fi
    envp=${https_proxy:-${HTTPS_PROXY:-${all_proxy:-${ALL_PROXY:-}}}}
    if [ -n "$envp" ] && [ "$envp" != "$purl" ]; then
        r=$(fetch "https://$TEST_HOST/debian/" -x "$envp")
        [ "$r" = 0 ] && ok "HTTPS through the proxy in https_proxy ($envp) works" \
                     || warn "HTTPS through the proxy in https_proxy ($envp) fails: $(explain_curl "$r" | cut -d: -f2)"
    fi
    case "$pmode" in
        none) info "desktop proxy: none (Firefox's default \"Use system proxy settings\" connects directly)" ;;
        manual) info "desktop proxy: $purl (Settings > Network > Proxy)" ;;
        auto) info "desktop proxy: automatic ${purl:-(WPAD)}" ;;
    esac
    [ -n "$aptp" ] && info "APT uses the proxy $aptp"
    for v in http_proxy https_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY; do
        eval "val=\${$v:-}"
        [ -n "$val" ] && info "environment: $v=$val"
    done
    for f in /etc/environment /etc/profile.d/*.sh; do
        [ -f "$f" ] && grep -qiE '^[^#]*(https?_proxy|all_proxy)' "$f" 2>/dev/null && info "a proxy is set in $f"
    done
    if [ "$https_d" != 0 ] && [ "$pmode" != manual ]; then
        wpad=$(find_wpad || true)
        if [ -n "$wpad" ]; then
            warn "this network publishes a proxy configuration (WPAD): $wpad"
            more "Use it: Settings > Network > Proxy > Automatic, or in Firefox:"
            more "Settings > Network Settings > Auto-detect proxy settings for this network."
        elif [ -n "$aptp" ]; then
            warn "APT reaches the internet through $aptp, but the desktop has no proxy"
            more "Set the same proxy in Settings > Network > Proxy (Manual)."
        elif [ "$http_d" = 0 ]; then
            more "Ask the network administrator for the proxy address and set it in"
            more "Settings > Network > Proxy."
        fi
    fi

    # IPv6: a network that announces IPv6 without routing it makes some
    # connections wait for a timeout before falling back to IPv4.
    if have ip && [ -n "$(ip -6 route show default 2>/dev/null)" ]; then
        r6=$(fetch "http://$TEST_HOST/debian/" -6 --noproxy '*')
        r4=$(fetch "http://$TEST_HOST/debian/" -4 --noproxy '*')
        if [ "$r6" != 0 ] && [ "$r4" = 0 ]; then
            conn=$(nmcli -t -g GENERAL.CONNECTION device show 2>/dev/null | grep . | head -n1)
            warn "IPv6 has a default route but does not reach the internet (IPv4 does)"
            more "Turn IPv6 off for this network: nmcli connection modify \"${conn:-<connection>}\" ipv6.method disabled"
            more "then reconnect. (Firefox: about:config network.dns.disableIPv6 = true also helps.)"
        elif [ "$r6" = 0 ]; then
            ok "IPv6 works"
        fi
    else
        info "no IPv6 default route (programs use IPv4 only)"
    fi
fi

# --------------------------------------------------- Firefox profile
if [ "$(id -u)" != 0 ] && [ -d "$HOME/.mozilla/firefox" ]; then
    for p in "$HOME"/.mozilla/firefox/*/prefs.js; do
        [ -f "$p" ] || continue
        prof=$(basename "$(dirname "$p")")
        t=$(sed -n 's/^user_pref("network.proxy.type", \([0-9]*\));/\1/p' "$p" | tail -n1)
        case "${t:-5}" in
            0) info "Firefox profile $prof: no proxy (ignores the desktop proxy)" ;;
            1) info "Firefox profile $prof: manual proxy $(sed -n 's/^user_pref("network.proxy.http", "\(.*\)");/\1/p' "$p" | tail -n1)" ;;
            2) info "Firefox profile $prof: proxy configuration URL $(sed -n 's/^user_pref("network.proxy.autoconfig_url", "\(.*\)");/\1/p' "$p" | tail -n1)" ;;
            4) info "Firefox profile $prof: auto-detects the proxy (WPAD)" ;;
            5) : ;;
        esac
        trr=$(sed -n 's/^user_pref("network.trr.mode", \([0-9]*\));/\1/p' "$p" | tail -n1)
        case "${trr:-0}" in
            2|3) info "Firefox profile $prof: DNS over HTTPS is on (network.trr.mode=$trr); networks that block it need mode 5 (off)" ;;
        esac
    done
fi

# --------------------------------------------------- NetworkManager state
if have nmcli && nm_running; then
    say ""
    say "NetworkManager"
    state=$(nmcli -t -f STATE,CONNECTIVITY general 2>/dev/null || true)
    info "state:connectivity = ${state:-unknown} (the check is plain HTTP to network-test.debian.org; it passes behind a transparent proxy)"
    case "$state" in
        *:full)
            if [ "$dns_ok" = 0 ]; then
                more "\"full\" is wrong here: NetworkManager's own check asks the network's DNS servers"
                more "directly, but programs (Firefox, APT) resolve names through $RESOLV, which does not work."
            fi ;;
    esac
    check=$(nmcli networking connectivity 2>/dev/null || true)
    if [ "$check" = unknown ] && ! ls /usr/lib/NetworkManager/conf.d/*connectivity* /etc/NetworkManager/conf.d/*connectivity* >/dev/null 2>&1; then
        warn "connectivity checking is off; install debion-desktop-base or network-manager-config-connectivity-debian"
    fi
    unmanaged=$(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '($2=="ethernet"||$2=="wifi") && $3=="unmanaged" {print $1}' | tr '\n' ' ')
    [ -n "$unmanaged" ] && warn "devices unmanaged by NetworkManager: $unmanaged"
fi

# ------------------------------------------------------------------- fix
if [ "$MODE" = fix ]; then
    if [ "$(id -u)" != 0 ]; then
        echo "debion-network-check --fix must run as root (sudo)." >&2
        exit 1
    fi
    say ""
    say "Fixing"
    fixed=0
    if [ -n "$conflicts" ]; then
        list=$(printf '%s\n' "$conflicts" | tr '\n' ' '); list=${list% }
        # Over SSH the handover waits for the next boot unless --now.
        now=1
        if [ -n "${SSH_CONNECTION:-}" ] && [ "$NOW" != 1 ]; then now=0; fi
        handover "$list" "$now" "$BACKUPS/$(stamp)"
        [ "$now" = 0 ] && echo "Reboot to finish (or run again with --now; this drops the SSH connection)."
        fixed=1
    fi
    pending=$(pending_handover)
    if [ -n "$pending" ]; then
        if [ -n "${SSH_CONNECTION:-}" ] && [ "$NOW" != 1 ]; then
            echo "The handover of $pending finishes at the next boot (or run with --now)."
        else
            # ifdown needs the old configuration to release the leases.
            old=$(pending_backup)
            for n in $pending; do
                if [ -f "$old" ] && have ifdown; then ifdown --force -i "$old" "$n" >/dev/null 2>&1 || true; fi
            done
            rm -f "$NM_RUN_CONF/90-debion-handover.conf"
            if have systemctl && [ -d "$SYSTEMD_RUN" ]; then systemctl restart NetworkManager.service || true; fi
            echo "NetworkManager now manages $pending."
        fi
        fixed=1
    fi
    if [ -n "$dup" ] && have ifdown; then
        printf '%s\n' "$dup" | while read -r pid client dev; do
            [ "$dev" = "*" ] && { echo "Stop the stray $client manager by hand: sudo kill $pid"; continue; }
            if ifquery --state "$dev" >/dev/null 2>&1; then
                ifdown --force "$dev" >/dev/null 2>&1 && echo "ifupdown released $dev (PID $pid)"
                nmcli device connect "$dev" >/dev/null 2>&1 || true
            else
                echo "Stop the stray $client on $dev by hand: sudo kill $pid"
            fi
        done
        fixed=1
    fi
    if [ -f "$RESOLV" ] && [ ! -L "$RESOLV" ]; then
        case "$(stat -c %a "$RESOLV" 2>/dev/null)" in
            *[4567]|"") ;;
            *) chmod a+r "$RESOLV" && echo "$RESOLV is readable by everyone again." && fixed=1 ;;
        esac
    fi
    # DNS: give /etc/resolv.conf back to one owner, make NetworkManager write
    # its servers into it, and check the result instead of hoping.
    dns_rc=0
    case "$resolv" in
        dangling|resolved-off|missing|empty|dhclient) broken_owner=1 ;;
        *) broken_owner=0 ;;
    esac
    if [ "$broken_owner" = 1 ] || ! dns_works; then
        dns_repair; dns_rc=$?
        fixed=1
    fi
    if have timedatectl && [ "$(timedatectl show -p NTP --value 2>/dev/null)" = no ] &&
       { [ -x /lib/systemd/systemd-timesyncd ] || [ -x /usr/lib/systemd/systemd-timesyncd ]; }; then
        timedatectl set-ntp true && echo "Network time (systemd-timesyncd) is on." && fixed=1
    fi
    if [ -n "$skew" ] && [ "$(abs "$skew")" -gt 300 ]; then
        date -s "@$(( $(date +%s) - skew ))" >/dev/null && echo "The clock was off by $skew s and is set again." && fixed=1
        have hwclock && hwclock --systohc >/dev/null 2>&1 || true
    fi
    [ "$fixed" = 1 ] || echo "Nothing to fix automatically."
    # 4: DNS still does not work (the output says what to do next).
    [ "$dns_rc" = 0 ] || exit 4
    exit 0
fi

say ""
if [ "$problems" = 0 ]; then say "No problems found."; else say "$problems problem(s) found."; fi
exit 0
