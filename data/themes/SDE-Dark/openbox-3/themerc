# SDE window theme for Openbox (SDE-Dark).
# SPDX-License-Identifier: GPL-3.0-or-later

border.width: 1
padding.width: 8
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0

window.active.border.color: #0B1015
window.inactive.border.color: #0B1015
window.active.client.color: #182027
window.inactive.client.color: #182027

window.active.title.bg: flat solid
window.active.title.bg.color: #1F2830
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #182027
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #E6EDF2
window.inactive.label.text.color: #7C8A95
window.label.text.justify: center

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #E6EDF2
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #33414C
window.active.button.hover.image.color: #E6EDF2
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #2FA3C2
window.active.button.pressed.image.color: #FFFFFF
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #7C8A95
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #2FA3C2
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #7C8A95
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #33414C
window.inactive.button.hover.image.color: #E6EDF2
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #2FA3C2
window.inactive.button.pressed.image.color: #FFFFFF
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #7C8A95
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #7C8A95

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1F2830
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #182027
window.active.grip.bg: flat solid
window.active.grip.bg.color: #1F2830
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #182027

menu.border.width: 1
menu.border.color: #0B1015
menu.items.bg: flat solid
menu.items.bg.color: #1F2830
menu.items.text.color: #E6EDF2
menu.items.disabled.text.color: #7C8A95
menu.items.active.bg: flat solid
menu.items.active.bg.color: #2FA3C2
menu.items.active.text.color: #FFFFFF
menu.title.bg: flat solid
menu.title.bg.color: #1F2830
menu.title.text.color: #E6EDF2
menu.title.text.justify: left
menu.separator.color: #0B1015
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3

osd.border.width: 1
osd.border.color: #0B1015
osd.bg: flat solid
osd.bg.color: #1F2830
osd.label.bg: parentrelative
osd.label.text.color: #E6EDF2
osd.hilight.bg: flat solid
osd.hilight.bg.color: #2FA3C2
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0B1015
