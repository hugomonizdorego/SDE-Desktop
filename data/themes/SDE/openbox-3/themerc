# SDE window theme for Openbox (SDE).
# SPDX-License-Identifier: GPL-3.0-or-later

border.width: 1
padding.width: 8
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0

window.active.border.color: #C9D1D8
window.inactive.border.color: #C9D1D8
window.active.client.color: #FAFBFC
window.inactive.client.color: #FAFBFC

window.active.title.bg: flat solid
window.active.title.bg.color: #F3F5F7
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #FAFBFC
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #1E2A33
window.inactive.label.text.color: #8A96A0
window.label.text.justify: center

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #1E2A33
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #DDE3E8
window.active.button.hover.image.color: #1E2A33
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #167D9A
window.active.button.pressed.image.color: #FFFFFF
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #8A96A0
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #167D9A
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #8A96A0
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #DDE3E8
window.inactive.button.hover.image.color: #1E2A33
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #167D9A
window.inactive.button.pressed.image.color: #FFFFFF
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #8A96A0
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #8A96A0

window.active.handle.bg: flat solid
window.active.handle.bg.color: #F3F5F7
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #FAFBFC
window.active.grip.bg: flat solid
window.active.grip.bg.color: #F3F5F7
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #FAFBFC

menu.border.width: 1
menu.border.color: #C9D1D8
menu.items.bg: flat solid
menu.items.bg.color: #FFFFFF
menu.items.text.color: #1E2A33
menu.items.disabled.text.color: #8A96A0
menu.items.active.bg: flat solid
menu.items.active.bg.color: #167D9A
menu.items.active.text.color: #FFFFFF
menu.title.bg: flat solid
menu.title.bg.color: #FFFFFF
menu.title.text.color: #1E2A33
menu.title.text.justify: left
menu.separator.color: #C9D1D8
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3

osd.border.width: 1
osd.border.color: #C9D1D8
osd.bg: flat solid
osd.bg.color: #FFFFFF
osd.label.bg: parentrelative
osd.label.text.color: #1E2A33
osd.hilight.bg: flat solid
osd.hilight.bg.color: #167D9A
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #C9D1D8
