    <category>System</category>
    <category>FileTools</category>
    <category>FileManager</category>
  </categories>
  <icon type="stock">liria</icon>
  <url type="homepage">https://github.com/hugomonizdorego/SDE-Desktop</url>
  <url type="bugtracker">https://github.com/hugomonizdorego/SDE-Desktop/issues</url>
  <project_group>SDE</project_group>
  <provides>
    <binary>liria</binary>
    <dbus type="user">org.freedesktop.FileManager1</dbus>
  </provides>
  <content_rating type="oars-1.1"/>
