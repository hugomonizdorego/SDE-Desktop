# SPDX-License-Identifier: GPL-3.0-or-later
# SDE Welcome at login. It exits at once in the live session of the ISO, and
# after the first login of each user when sde.conf [welcome] show=false (the
# "Show this dialog at startup" check box). See docs/MINT-CONCEPTS.md.
[Desktop Entry]
Type=Application
Name=SDE Welcome
Comment=Shows the welcome screen at login
Exec=sde-welcome --autostart
TryExec=sde-welcome
OnlyShowIn=SDE;
NoDisplay=true
