#: src/merkadu/main.cpp:34
msgid ""
"Merkadu: find, install, update and remove software from the Debian archive, "
"Flatpak and Snap.\n"
"\n"
"Usage: merkadu [--page NAME] [--search TEXT] [--category ID] [--details "
"APPID]\n"
"       merkadu appstream://APPID\n"
"       merkadu --uninstall FILE.desktop\n"
"       merkadu --version\n"
"\n"
"  --page NAME       open a page: explore, installed, updates, history, "
"progress or sources\n"
"  --search TEXT     search for apps\n"
"  --category ID     open a department (games, graphics/photography, ...)\n"
"  --details APPID   open the page of an app (its AppStream id, e.g. org.gimp."
"GIMP)\n"
"  --uninstall FILE  uninstall the app of a launcher (the absolute path of "
"its .desktop\n"
"                    file), asking first; exits with 0 when it was removed, 1 "
"when it\n"
"                    failed or cannot be removed, 2 when the user cancelled\n"
"  --version         print the version and exit\n"
msgstr ""

