#: src/update/main.cpp:248
msgid ""
"Usage: sde-update [--page NAME] [--version]\n"
"       sde-update --check | --history | --sources\n"
"       sde-update --plan refresh|upgrade|autoremove|clean|repair "
"[PACKAGE...]\n"
"       sde-update --plan flatpak system|user:REF...\n"
"       sde-update --transaction refresh|upgrade\n"
"       sde-update --notifier [--once]\n"
"\n"
"  --page NAME     open updates, history, sources, maintenance, settings or "
"about\n"
"  --check         print the read-only update list (SDE-UPDATES protocol)\n"
"  --history       print the APT history (SDE-HISTORY protocol)\n"
"  --sources       print the package sources (SDE-SOURCES protocol)\n"
"  --plan          print the fixed command of a transaction without running "
"it\n"
"  --transaction   run an interactive PackageKit transaction in this "
"terminal\n"
"  --notifier      check for updates in the background and notify\n"
msgstr ""

