#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Makes DebION the active desktop-base theme. desktop-base's own
# alternatives (desktop background, login background, lock screen, Plasma
# wallpaper, GRUB) point into /usr/share/desktop-base/active-theme, so they
# all follow this one. Debian's themes have priority 50 or less.
set -e
DB=/usr/share/desktop-base
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-remove" ]; then
    update-alternatives --install $DB/active-theme desktop-theme $DB/debion-theme 60

    update-alternatives --install /usr/share/images/vendor-logos vendor-logos $DB/debion-logos 60 \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor.png emblem-vendor-64 $DB/debion-logos/logo-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor.png emblem-vendor-128 $DB/debion-logos/logo-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor.png emblem-vendor-256 $DB/debion-logos/logo-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor.svg emblem-vendor-scalable $DB/debion-logos/logo.svg \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-64 $DB/debion-logos/emblem-symbolic-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-128 $DB/debion-logos/emblem-symbolic-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-256 $DB/debion-logos/emblem-symbolic-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-symbolic.svg emblem-vendor-symbolic-scalable $DB/debion-logos/emblem-symbolic.svg \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-white.png emblem-vendor-white-64 $DB/debion-logos/emblem-white-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-white.png emblem-vendor-white-128 $DB/debion-logos/emblem-white-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-white.png emblem-vendor-white-256 $DB/debion-logos/emblem-white-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-white.svg emblem-vendor-white-scalable $DB/debion-logos/emblem-white.svg

    # Boot splash: only replace a Debian desktop-base splash or the default,
    # never a theme the administrator chose. The initramfs picks it up at
    # its next update.
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        current=$(plymouth-set-default-theme 2>/dev/null || true)
        case "$current" in
            ""|emerald|ceratopsian|homeworld|futureprototype|moonlight|softwaves|lines|joy|spacefun|debian-theme|bgrt|spinner)
                plymouth-set-default-theme debion || true ;;
        esac
    fi

    # Refresh the GRUB background when GRUB is the boot loader.
    if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
        update-grub >/dev/null 2>&1 || echo "debion-desktop-base: update-grub failed; run it later"
    fi
fi
#DEBHELPER#
exit 0
