#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
if [ "$1" = "configure" ]; then
    # Alpha builds before 0.1.0~alpha10 saved the session as "sde". Accounts
    # that chose it move to the new "sde-desktop" name; others are untouched.
    for f in /var/lib/AccountsService/users/*; do
        [ -f "$f" ] || continue
        if grep -qx 'XSession=sde' "$f"; then
            sed -i 's/^XSession=sde$/XSession=sde-desktop/' "$f"
        fi
    done

    # GNOME Terminal is the terminal of SDE-Desktop (0.2.0 Alpha 4): the
    # x-terminal-emulator alternative points to it, unless the administrator
    # chose a terminal (the alternative is then in manual mode). Only on the
    # installation and on the upgrade from an older sde-desktop, so a later
    # "update-alternatives --auto x-terminal-emulator" is kept. SDE's own
    # default terminal ("auto" in Control Center > Default Applications)
    # follows the alternative.
    if [ -z "$2" ] || dpkg --compare-versions "$2" lt 0.2.0~alpha4~; then
        wrapper=/usr/bin/gnome-terminal.wrapper
        query=$(update-alternatives --query x-terminal-emulator 2>/dev/null || true)
        if printf '%s\n' "$query" | grep -qx 'Status: auto' &&
           printf '%s\n' "$query" | grep -qx "Alternative: $wrapper" &&
           ! printf '%s\n' "$query" | grep -qx "Value: $wrapper"; then
            update-alternatives --set x-terminal-emulator "$wrapper"
        fi
    fi
fi
#DEBHELPER#
exit 0
