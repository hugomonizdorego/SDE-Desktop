#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
if [ "$1" = "configure" ]; then
    # startsde is the x-session-manager of SDE. Up to 0.2.0~alpha3.1 the
    # sde package registered it; registering it again keeps an
    # administrator's choice of another session manager.
    update-alternatives --install /usr/bin/x-session-manager x-session-manager \
        /usr/bin/startsde 30
    # SDE's fingerprint profiles (/usr/share/pam-configs/sde-fingerprint-*,
    # docs/FINGERPRINT.md), as libpam-fprintd registers its own.
    if command -v pam-auth-update >/dev/null 2>&1; then
        pam-auth-update --package
    fi
fi
#DEBHELPER#
exit 0
