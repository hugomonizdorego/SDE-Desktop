+/* SDE: a PNG mask of a caption button, or NULL. */
+static RrImage* read_button_png(const gchar *path, const RrTheme *theme,
+                                const gchar *btnname, const gchar *state)
+{
+    RrImage *image = NULL;
+    gchar *file = g_strdup_printf("%s%s.png", btnname, state);
+    gchar *s = g_build_filename(path, file, NULL);
+    if (g_file_test(s, G_FILE_TEST_IS_REGULAR))
+        image = RrImageNewFromName(theme->button_images, s);
+    g_free(s);
+    g_free(file);
+    return image;
+}
+
+/* SDE: |mask| tinted with |color|: the color with the mask's alpha. */
+static RrImage* tint_button_png(const RrTheme *theme, RrImage *mask,
+                                const RrColor *color)
+{
+    RrImagePic *pic;
+    RrPixel32 *data, rgb;
+    RrImage *image;
+    gint i, n;
+
+    if (!mask || !color || mask->set->n_original < 1)
+        return NULL;
+    pic = mask->set->original[0];
+    n = pic->width * pic->height;
+    rgb = ((RrPixel32)(color->r & 0xff) << RrDefaultRedOffset) |
+          ((RrPixel32)(color->g & 0xff) << RrDefaultGreenOffset) |
+          ((RrPixel32)(color->b & 0xff) << RrDefaultBlueOffset);
+    data = g_new(RrPixel32, n);
+    for (i = 0; i < n; ++i)
+        data[i] = rgb | (pic->data[i] & ((RrPixel32)0xff << RrDefaultAlphaOffset));
+    image = RrImageNewFromData(theme->button_images, data, pic->width, pic->height);
+    g_free(data);
+    return image;
+}
+
+/* SDE: antialiased caption buttons. Next to its XBM masks a theme may have
+   8-bit masks as PNG pictures, named like them (close.png, close_hover.png,
+   max_toggled.png, max_hover_toggled.png, ...): any color on transparent,
+   square and larger than the buttons (they are only scaled down). Each
+   state's picture is its mask tinted with the state's image.color, and it is
+   scaled with the button, whose size follows the title height and so the
+   interface scale: the glyphs stay smooth at 125 % or 200 %. A missing state
+   falls back like the XBM masks; without <button>.png the button keeps its
+   XBM masks. Stock Openbox ignores the pictures. */
+static void read_button_images(gchar *path, const RrTheme *theme,
+                               RrButton *btn, const gchar *btnname,
+                               gboolean toggled)
+{
+    enum { UNPRESSED, PRESSED, DISABLED, HOVER,
+           UNPRESSED_TOGGLED, PRESSED_TOGGLED, HOVER_TOGGLED, STATES };
+    static const gchar *const suffix[STATES] = {
+        "", "_pressed", "_disabled", "_hover",
+        "_toggled", "_pressed_toggled", "_hover_toggled" };
+    RrImage *mask[STATES] = { NULL };
+    RrAppearance *focused[STATES] = {
+        btn->a_focused_unpressed, btn->a_focused_pressed,
+        btn->a_focused_disabled, btn->a_focused_hover,
+        btn->a_focused_unpressed_toggled, btn->a_focused_pressed_toggled,
+        btn->a_focused_hover_toggled };
+    RrAppearance *unfocused[STATES] = {
+        btn->a_unfocused_unpressed, btn->a_unfocused_pressed,
+        btn->a_unfocused_disabled, btn->a_unfocused_hover,
+        btn->a_unfocused_unpressed_toggled, btn->a_unfocused_pressed_toggled,
+        btn->a_unfocused_hover_toggled };
+    const RrColor *focused_color[STATES] = {
+        btn->focused_unpressed_color, btn->focused_pressed_color,
+        btn->focused_disabled_color, btn->focused_hover_color,
+        btn->focused_unpressed_toggled_color,
+        btn->focused_pressed_toggled_color,
+        btn->focused_hover_toggled_color };
+    const RrColor *unfocused_color[STATES] = {
+        btn->unfocused_unpressed_color, btn->unfocused_pressed_color,
+        btn->unfocused_disabled_color, btn->unfocused_hover_color,
+        btn->unfocused_unpressed_toggled_color,
+        btn->unfocused_pressed_toggled_color,
+        btn->unfocused_hover_toggled_color };
+    gint i, states = toggled ? STATES : UNPRESSED_TOGGLED;
+
+    if (!(mask[UNPRESSED] = read_button_png(path, theme, btnname, "")))
+        return;
+    for (i = 1; i < states; ++i) {
+        mask[i] = read_button_png(path, theme, btnname, suffix[i]);
+        if (!mask[i]) {
+            /* the same fallbacks as the XBM masks */
+            mask[i] = mask[i > UNPRESSED_TOGGLED ? UNPRESSED_TOGGLED : UNPRESSED];
+            RrImageRef(mask[i]);
+        }
+    }
+    for (i = 0; i < states; ++i) {
+        gint f;
+        for (f = 0; f < 2; ++f) {
+            RrAppearance *a = f ? unfocused[i] : focused[i];
+            RrImage *image = tint_button_png(theme, mask[i],
+                                             f ? unfocused_color[i] :
+                                                 focused_color[i]);
+            if (!image)
+                continue;
+            btn->images[i * 2 + f] = image;
+            a->texture[0].type = RR_TEXTURE_IMAGE;
+            a->texture[0].data.image.image = image;
+            a->texture[0].data.image.alpha = 255;
+            a->texture[0].data.image.tx = 0;
+            a->texture[0].data.image.ty = 0;
+            a->texture[0].data.image.twidth = 0;
+            a->texture[0].data.image.theight = 0;
+        }
+    }
+    for (i = 0; i < states; ++i)
+        RrImageUnref(mask[i]);
+}
