+    /* SDE: wide caption buttons that follow the font (and so the UI scale) */
+    READ_INT("window.button.width.percent", theme->button_width, 0, 1000, 0);
+    READ_INT("window.button.height.percent", theme->button_height, 0, 100, 0);
+    READ_INT("window.button.spacing", theme->button_spacing, -1, 100, -1);
 
     /* load colors */
