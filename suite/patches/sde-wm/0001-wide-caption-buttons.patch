+        theme->button_size;
+    theme->button_height = theme->button_height > 0 ?
+        MAX(theme->button_size, theme->title_height * theme->button_height / 100) :
+        theme->button_size;
+    if (theme->button_spacing < 0)
+        theme->button_spacing = theme->paddingx + 1;
