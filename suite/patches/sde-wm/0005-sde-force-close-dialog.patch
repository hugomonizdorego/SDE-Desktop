+/* SDE: _SDE_NOT_RESPONDING (CARDINAL, the time it stopped answering) marks
+   a window whose program does not answer _NET_WM_PING. sde-watchdog sets it
+   for the window the user is using, and so does SDE WM when its own ping
+   after a close attempt is not answered; the first answer removes it. The
+   title then says "Not Responding", the panel dims the window's button, and
+   closing the window runs SDE's "Wait / Force Close" dialog at once. */
+Atom client_sde_not_responding_atom(void)
+{
+    static Atom atom = None;
+    if (atom == None)
+        atom = XInternAtom(obt_display, "_SDE_NOT_RESPONDING", FALSE);
+    return atom;
+}
+
+static gboolean client_sde_marked(ObClient *self)
+{
+    Atom type = None;
+    int format;
+    unsigned long n = 0, after = 0;
+    unsigned char *data = NULL;
+    gboolean marked = FALSE;
+
+    if (XGetWindowProperty(obt_display, self->window,
+                           client_sde_not_responding_atom(), 0, 1, False,
+                           AnyPropertyType, &type, &format, &n, &after,
+                           &data) == Success)
+    {
+        marked = type != None;
+        if (data) XFree(data);
+    }
+    return marked;
+}
+
+static void client_sde_mark(ObClient *self, gboolean dead)
+{
+    if (dead) {
+        unsigned long since = (unsigned long)time(NULL);
+        XChangeProperty(obt_display, self->window,
+                        client_sde_not_responding_atom(), XA_CARDINAL, 32,
+                        PropModeReplace, (unsigned char*)&since, 1);
+    } else
+        XDeleteProperty(obt_display, self->window,
+                        client_sde_not_responding_atom());
+}
+
+void client_update_sde_not_responding(ObClient *self)
+{
+    gboolean marked = client_sde_marked(self);
+
+    if (marked == self->not_responding) return;
+    self->not_responding = marked;
+    if (!marked) self->kill_level = 0;
+    client_update_title(self);
+}
+
+/* SDE: sde-force-close --window XID --reason closing, in place of the
+   prompt below; FALSE when it cannot be started. */
+static gboolean client_sde_force_close(ObClient *self)
+{
+    gchar xid[32];
+    gchar *argv[] = { "sde-force-close", "--window", xid,
+                      "--reason", "closing", NULL };
+    GError *err = NULL;
+
+    g_snprintf(xid, sizeof(xid), "0x%lx", (gulong)self->window);
+    if (!g_spawn_async(NULL, argv, NULL, G_SPAWN_SEARCH_PATH,
+                       NULL, NULL, NULL, &err))
+    {
+        ob_debug("sde-force-close: %s", err ? err->message : "failed");
+        if (err) g_error_free(err);
+        return FALSE;
+    }
+    return TRUE;
+}
+
