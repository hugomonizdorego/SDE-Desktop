+// SDE: the backdrop of a window, for window shaders that mention `backdrop`
+// (only those are linked with it). `backdrop` holds what is drawn behind the
+// window's rectangle, already blurred when the window has background blur.
+const char backdrop_glsl[] = GLSL(330,
+	layout(location = UNIFORM_BACKDROP_LOC)
+	uniform sampler2D backdrop;
+	// xy: gl_FragCoord of the first texel of `backdrop`; z: 1 or -1, the
+	// direction of the window's y axis in gl_FragCoord; w: 1 when there is a
+	// backdrop (0 when the window is off the screen).
+	layout(location = UNIFORM_BACKDROP_RECT_LOC)
+	uniform vec4 backdrop_rect;
+	// What is behind the window `offset` window pixels (x right, y down) from
+	// this fragment, or transparent black without a backdrop.
+	vec4 backdrop_at(vec2 offset) {
+		if (backdrop_rect.w < 0.5) {
+			return vec4(0.0);
+		}
+		vec2 size = vec2(textureSize(backdrop, 0));
+		vec2 p = gl_FragCoord.xy + vec2(offset.x, offset.y * backdrop_rect.z) -
+		         backdrop_rect.xy;
+		return texture(backdrop, p / size);
+	}
+);
+
 const char blit_shader_default[] = GLSL(330,
 	in vec2 texcoord;
 	uniform sampler2D tex;
