+void commands_expand_backdrop_damage(const struct layout *layout, region_t *damage) {
+	region_t part;
+	pixman_region32_init(&part);
+	// A grown damage region can touch another such window: repeat while it grows
+	// (a few rounds are plenty for stacked menus).
+	for (int round = 0; round < 4; round++) {
+		bool grew = false;
+		for (unsigned i = layout->first_layer_start; i < layout->number_of_commands; i++) {
+			auto cmd = &layout->commands[i];
+			if (cmd->op != BACKEND_COMMAND_BLIT || !cmd->blit.sample_backdrop) {
+				continue;
+			}
+			pixman_region32_intersect(&part, &cmd->target_mask, damage);
+			if (!pixman_region32_not_empty(&part)) {
+				continue;
+			}
+			pixman_region32_subtract(&part, &cmd->target_mask, damage);
+			if (!pixman_region32_not_empty(&part)) {
+				continue;
+			}
+			pixman_region32_union(damage, damage, &cmd->target_mask);
+			grew = true;
+		}
+		if (!grew) {
+			break;
+		}
+	}
+	pixman_region32_fini(&part);
+}
