+/// SDE: copies what is on `target_` under the source image of `args` (the backdrop
+/// of a window: the windows below it, already blurred when it has background blur)
+/// into `gd->backdrop_texture`, and sets the `backdrop` uniforms for the shader.
+static void gl_copy_backdrop(struct gl_data *gd, ivec2 origin, image_handle target_,
+                             const struct backend_blit_args *args,
+                             struct gl_uniform_value *uniforms) {
+	auto target = (struct gl_texture *)target_;
+	auto source = (struct gl_texture *)args->source_image;
+	// The source's rectangle on the target, clipped to the target.
+	int x1 = max2(origin.x, 0), y1 = max2(origin.y, 0);
+	int x2 = min2(origin.x + (int)(source->width * args->scale.x + 0.5), target->width);
+	int y2 = min2(origin.y + (int)(source->height * args->scale.y + 0.5), target->height);
+	uniforms[UNIFORM_BACKDROP_RECT_LOC] =
+	    (struct gl_uniform_value){.type = GL_FLOAT_VEC4, .f4 = {0, 0, 1, 0}};
+	if (x2 <= x1 || y2 <= y1) {
+		return;
+	}
+	int w = x2 - x1, h = y2 - y1;
+	if (!gd->backdrop_texture) {
+		gd->backdrop_texture = gl_new_texture();
+		glGenFramebuffers(1, &gd->backdrop_fbo);
+		if (!gd->backdrop_texture || !gd->backdrop_fbo) {
+			return;
+		}
+	}
+	if (gd->backdrop_size.width != w || gd->backdrop_size.height != h) {
+		glActiveTexture(GL_TEXTURE0);
+		glBindTexture(GL_TEXTURE_2D, gd->backdrop_texture);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+		glBindTexture(GL_TEXTURE_2D, 0);
+		gd->backdrop_size = (ivec2){.width = w, .height = h};
+	}
+	// Our textures are Y-inverted, so a fragment's gl_FragCoord.y grows with the
+	// target's y; the GL back buffer is not, there it shrinks.
+	int ry1 = y1, ry2 = y2;
+	float dir = 1;
+	if (target == &gd->back_image) {
+		glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+		ry1 = target->height - y2;
+		ry2 = target->height - y1;
+		dir = -1;
+	} else {
+		glBindFramebuffer(GL_READ_FRAMEBUFFER, gd->temp_fbo);
+		glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+		                       GL_TEXTURE_2D, target->texture, 0);
+		glReadBuffer(GL_COLOR_ATTACHMENT0);
+	}
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, gd->backdrop_fbo);
+	glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+	                       gd->backdrop_texture, 0);
+	glDrawBuffer(GL_COLOR_ATTACHMENT0);
+	glBlitFramebuffer(x1, ry1, x2, ry2, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+	gl_check_err();
+	uniforms[UNIFORM_BACKDROP_LOC] = (struct gl_uniform_value){
+	    .type = GL_TEXTURE_2D,
+	    .tu = {gd->backdrop_texture, gd->samplers[GL_SAMPLER_BLUR]},
+	};
+	uniforms[UNIFORM_BACKDROP_RECT_LOC].f4[0] = (float)x1;
+	uniforms[UNIFORM_BACKDROP_RECT_LOC].f4[1] = (float)ry1;
+	uniforms[UNIFORM_BACKDROP_RECT_LOC].f4[2] = dir;
+	uniforms[UNIFORM_BACKDROP_RECT_LOC].f4[3] = 1;
+}
