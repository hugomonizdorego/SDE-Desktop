+/// SDE: on a backend whose window images are copies made when the pixmap was
+/// bound (BACKEND_QUIRK_PIXMAP_SNAPSHOT: Mesa's software OpenGL), bind the
+/// pixmap of a window that was damaged since then again, so that the image
+/// has what the window has drawn. Otherwise such a window kept the content
+/// it had when it was mapped or last resized: a window resized while its
+/// program was still busy stayed at its old size, the rest of it
+/// see-through, until the compositor was reset. glx-no-rebind-pixmap turns
+/// this off.
+static void win_rebind_damaged_snapshot(session_t *ps, struct win *w) {
+	if (!w->pixmap_damaged || w->win_image == NULL || ps->backend_data == NULL ||
+	    ps->o.glx_no_rebind_pixmap ||
+	    !(ps->backend_data->ops.quirks(ps->backend_data) & BACKEND_QUIRK_PIXMAP_SNAPSHOT)) {
+		return;
+	}
+	w->pixmap_damaged = false;
+	auto pixmap = ps->backend_data->ops.release_image(ps->backend_data, w->win_image);
+	w->win_image = NULL;
+	if (pixmap == XCB_NONE) {
+		win_set_flags(w, WIN_FLAGS_PIXMAP_ERROR);
+		return;
+	}
+	w->win_image = ps->backend_data->ops.bind_pixmap(
+	    ps->backend_data, pixmap, x_get_visual_info(&ps->c, w->a.visual));
+	if (!w->win_image) {
+		log_error("Failed to bind pixmap");
+		xcb_free_pixmap(ps->c.c, pixmap);
+		win_set_flags(w, WIN_FLAGS_PIXMAP_ERROR);
+	}
+}
+
