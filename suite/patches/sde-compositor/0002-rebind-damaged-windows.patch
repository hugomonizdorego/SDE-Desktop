+/// SDE: whether the current context renders with Mesa's software OpenGL
+/// (llvmpipe, softpipe, swr: Xvfb, virtual machines without 3D, a missing
+/// driver). Its GLX_EXT_texture_from_pixmap copies the pixmap into the
+/// texture when it is bound; drawing into the pixmap afterwards does not
+/// reach the texture.
+static bool glx_software_renderer(Display *dpy) {
+#ifdef GLX_MESA_query_renderer
+	unsigned int accelerated = 1;
+	if (glxext.has_GLX_MESA_query_renderer &&
+	    glXQueryCurrentRendererIntegerMESA(GLX_RENDERER_ACCELERATED_MESA, &accelerated)) {
+		return accelerated == 0;
+	}
+#endif
+	const char *names[] = {"llvmpipe", "SWR", "softpipe"};
+	const char *vendor = glXGetClientString(dpy, GLX_VENDOR);
+	const char *renderer = (const char *)glGetString(GL_RENDERER);
+	if (vendor == NULL || renderer == NULL || strcmp(vendor, "Mesa Project and SGI") != 0) {
+		return false;
+	}
+	for (size_t i = 0; i < ARR_SIZE(names); i++) {
+		if (strstr(renderer, names[i]) != NULL) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static uint32_t glx_quirks(backend_t *base) {
+	return ((struct _glx_data *)base)->quirks;
+}
