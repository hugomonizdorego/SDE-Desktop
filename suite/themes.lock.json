                "themes/Flat-Remix-GTK-Green-Light", "themes/Flat-Remix-GTK-Green-Dark",
                "themes/Flat-Remix-GTK-Yellow-Light", "themes/Flat-Remix-GTK-Yellow-Dark",
                "themes/Flat-Remix-GTK-Orange-Light", "themes/Flat-Remix-GTK-Orange-Dark",
                "themes/Flat-Remix-GTK-Red-Light", "themes/Flat-Remix-GTK-Red-Dark",
                "themes/Flat-Remix-GTK-Magenta-Light", "themes/Flat-Remix-GTK-Magenta-Dark",
                "themes/Flat-Remix-GTK-Violet-Light", "themes/Flat-Remix-GTK-Violet-Dark",
