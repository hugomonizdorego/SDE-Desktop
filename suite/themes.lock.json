      "license": "GPL-3.0-only",
      "copyright": "2021-2025 Vince Liu (vinceliuice)",
      "paths": ["LICENSE", "README.md", "src/sass", "src/main/gtk-3.0", "src/main/gtk-4.0",
                "src/assets/gtk"],
      "use": "GTK 3 and GTK 4 style sheets compiled with sassc for every SDE accent, plus the accent-colored check, radio and switch assets"
    },
    {
